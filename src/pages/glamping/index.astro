---
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import GlampingCard from "../../components/ui/GlampingCard.astro";
import { glamping, glampingPath } from "../../data/glamping";
import { formatIDR } from "../../lib/format";
import { localizePath } from "../../lib/i18n";

export const prerender = true;

const locale = "id" as const;
const L = (p: string) => localizePath(p, locale);
const copy = {
	title: "Semua Glamping",
	eyebrow: "Menginap",
	description:
		"8 tenda glamping dinamai gunung-gunung Jawa Barat, matras hangat, kamar mandi sendiri, sarapan, dan api unggun termasuk.",
	meta: "Semua glamping Pondok Rasamala: 8 tenda, harga per tier pax, termasuk sarapan & api unggun. Pesan via WhatsApp.",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container index-head">
		<SectionHeader
			eyebrow={copy.eyebrow}
			title={copy.title}
			description={copy.description}
			align="left"
		/>
		<div class="card-grid">
			{glamping.map((g) => {
				const min = Math.min(...g.tiers.map((tier) => tier.price));
				const pax = g.tiers.map((tier) => tier.pax);
				return (
					<GlampingCard
						href={L(glampingPath(g.slug))}
						name={`Glamping ${g.name}`}
						eyebrow={`Glamping · ${Math.min(...pax)}–${Math.max(...pax)} orang`}
						fromPrice={`Mulai ${formatIDR(min)}`}
						priceNote="Harga konfirmasi via WhatsApp"
						blurb={g.tagline.id}
						imageLabel={`Glamping ${g.name}: foto menyusul`}
					/>
				);
			})}
		</div>
	</div>
</Base>

<style>
	.index-head {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	/* Compact editorial: three cards per row, full container width so the
	   grid aligns with the header, deep gaps for breathing room. */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-3xl);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-3xl);
	}
	@media (max-width: 1100px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 700px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
