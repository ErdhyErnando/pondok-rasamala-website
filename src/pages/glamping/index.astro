---
import StayIndex from "../../components/layout/StayIndex.astro";
import StayCard from "../../components/ui/StayCard.astro";
import { getTentCards, getSizeBuckets } from "../../lib/stay";

export const prerender = true;

const locale = "id" as const;
const copy = {
	title: "Semua Glamping",
	description:
		"8 tenda glamping dinamai gunung-gunung Jawa Barat, matras hangat, kamar mandi sendiri, sarapan, dan api unggun termasuk.",
	meta: "Semua glamping Pondok Rasamala: 8 tenda, harga per tier pax, termasuk sarapan & api unggun. Pesan via WhatsApp.",
};
const cards = getTentCards(locale);
const sizes = getSizeBuckets("glamping", locale);
---

<StayIndex locale={locale} title={copy.title} description={copy.description} meta={copy.meta} ctaKind="glamping" sizes={sizes}>
	{cards.map((c) => (
		<StayCard href={c.href} name={c.name} blurb={c.blurb} imageLabel={c.imageLabel} photo={c.photo} locale={locale} facts={c.facts} paxMin={c.paxMin} paxMax={c.paxMax} minPrice={c.minPrice} />
	))}
</StayIndex>
