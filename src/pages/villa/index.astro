---
import StayIndex from "../../components/layout/StayIndex.astro";
import StayCard from "../../components/ui/StayCard.astro";
import { getVillaCards, getSizeBuckets } from "../../lib/stay";

export const prerender = true;

const locale = "id" as const;
const copy = {
	title: "Semua Villa",
	description:
		"Villa bambu dan kayu di dalam Taman Nasional Gunung Halimun Salak, dari yang mungil untuk keluarga kecil sampai Villa Cendana untuk 28 orang.",
	meta: "Semua villa Pondok Rasamala: unit bambu, kayu, dan cottage, harga per malam, kapasitas. Pesan via WhatsApp.",
};
const cards = getVillaCards(locale);
const sizes = getSizeBuckets("villa", locale);
---

<StayIndex locale={locale} title={copy.title} description={copy.description} meta={copy.meta} ctaKind="villa" sizes={sizes}>
	{cards.map((c) => (
		<StayCard href={c.href} name={c.name} blurb={c.blurb} imageLabel={c.imageLabel} photo={c.photo} locale={locale} facts={c.facts} paxMin={c.paxMin} paxMax={c.paxMax} minPrice={c.minPrice} />
	))}
</StayIndex>
