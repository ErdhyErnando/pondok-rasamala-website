---
import Base from "../layouts/Base.astro";
import PhotoPlaceholder from "../components/ui/PhotoPlaceholder.astro";
import { attractions } from "../data/attractions";

export const prerender = true;

const locale = "id" as const;

// About-style rhythm: eyebrow + statement + sidenote, then editorial
// rows with dotted dividers instead of a card grid.
const copy = {
	title: "Atraksi Terdekat",
	eyebrow: "Jelajahi",
	meta: "Atraksi dekat Pondok Rasamala: Kawah Ratu, Curug Seribu, Curug Ngumpet, Curug Cigamea, Air Panas Ciparay, Curug Goa Lumut + tips kunjungan.",
	statement:
		"Kawah, curug, dan pemandian air panas, semua dalam jangkauan perjalanan dari resort.",
	side: `${attractions.length} spot pilihan · atur antar-jemput dan pemandu via WhatsApp.`,
	tipLabel: "Tips",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<h1 class="page-title reveal">{copy.title}</h1>
		<div class="page-visual reveal">
			<PhotoPlaceholder
				label="Atraksi sekitar resort: foto menyusul"
				ratio="16 / 8"
			/>
		</div>
		<p class="statement reveal">{copy.statement}</p>
		<div class="attraction-rows">
			{attractions.map((a, i) => (
				<article class="attraction-row reveal">
					<span class="row-index" aria-hidden="true">
						{String(i + 1).padStart(2, "0")}
					</span>
					<div class="row-visual">
						<PhotoPlaceholder
							label={`${a.name.id}: foto menyusul`}
							ratio="16 / 10"
						/>
					</div>
					<div class="row-body">
						<h2>{a.name.id}</h2>
						<p>{a.description.id}</p>
						<p class="tip"><strong>{copy.tipLabel}:</strong> {a.tip.id}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.page-title {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.page-visual {
		margin-top: var(--spacing-2xl);
	}
	.statement {
		margin-top: var(--spacing-2xl);
		font-size: clamp(1.4rem, 2.6vw, 2rem);
		line-height: 1.25;
		letter-spacing: -0.02em;
		font-weight: 600;
		text-wrap: balance;
		max-width: 28ch;
	}
	.attraction-rows {
		margin-top: var(--spacing-3xl);
		border-top: 1px solid var(--color-border);
	}
	.attraction-row {
		display: grid;
		grid-template-columns: 3rem 5fr 7fr;
		gap: var(--spacing-xl);
		align-items: start;
		padding: var(--spacing-2xl) 0;
		border-bottom: 1px dashed var(--color-border);
	}
	.row-index {
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		letter-spacing: 0.08em;
		padding-top: 0.2rem;
	}
	.row-visual :global(.photo-placeholder) {
		border-radius: var(--radius-lg);
	}
	.row-body h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		letter-spacing: var(--tracking-snug);
	}
	.row-body p {
		margin-top: var(--spacing-xs);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		max-width: 56ch;
	}
	.tip {
		color: var(--color-text) !important;
		margin-top: var(--spacing-sm) !important;
		font-size: var(--font-size-sm);
	}
	@media (max-width: 900px) {
		.attraction-row {
			grid-template-columns: 1fr;
			gap: var(--spacing-md);
		}
		.row-index {
			padding-top: 0;
		}
	}
</style>
