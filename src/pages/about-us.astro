---
import Base from "../layouts/Base.astro";
import PhotoPlaceholder from "../components/ui/PhotoPlaceholder.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import { localizePath } from "../lib/i18n";

export const prerender = true;

const locale = "id" as const;
const L = (p: string) => localizePath(p, locale);
const copy = {
	title: "Tentang Kami",
	meta: "Pondok Rasamala: resort bambu & kayu bernuansa alam pedesaan di Gunung Salak Endah, dalam Taman Nasional Gunung Halimun Salak.",
	statement: "Resort bernuansa alam pedesaan — bangunan bambu dan kayu yang artistik di tengah hutan Taman Nasional Gunung Halimun Salak.",
	side: "16 unit bungalow · 8 tenda glamping · aula · area outbound — ±90 km dari Jakarta, di ketinggian 1.000–1.200 mdpl.",
	body1:
		"Pondok Rasamala berdiri di kawasan wisata Gunung Salak Endah (Gunung Bunder), Pamijahan, Bogor — di dalam Taman Nasional Gunung Halimun Salak. Setiap unitnya dirancang berbeda dari bambu dan kayu, menyatu dengan taman bunga, saung-saung, dan udara gunung yang sejuk sepanjang hari.",
	body2:
		"Kami melayani liburan keluarga, gathering perusahaan, acara sekolah, dan komunitas — dengan villa berkapasitas 4 sampai 28 orang, glamping untuk 4–10 orang, aula pertemuan, dan lapangan outbound. Semua pemesanan langsung via WhatsApp, tanpa perantara.",
	links: [
		{ href: L("/villa/"), title: "Villa & cottage", desc: "16 unit untuk segala ukuran rombongan" },
		{ href: L("/package/"), title: "Paket & outbound", desc: "Gathering, sekolah, dan keluarga" },
		{ href: L("/location/"), title: "Lokasi & rute", desc: "±2 jam dari Jakarta, ±1,5 jam dari Bogor" },
	],
	ctaTitle: "Rasakan sendiri tenangnya",
	ctaBody: "Ceritakan rencana liburan — kami bantu pilihkan unit yang pas.",
};
const waMessage = "Halo Pondok Rasamala, saya mau bertanya tentang resort. Terima kasih.";
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container about">
		<p class="eyebrow reveal">{copy.title}</p>
		<div class="statement-grid">
			<h1 class="reveal">{copy.statement}</h1>
			<aside class="sidenote reveal">{copy.side}</aside>
		</div>
		<div class="about-visual reveal">
			<PhotoPlaceholder label="Suasana resort — foto menyusul" ratio="16 / 8" />
		</div>
		<div class="prose">
			<p>{copy.body1}</p>
			<p>{copy.body2}</p>
		</div>
		<nav class="sub-links" aria-label="Jelajahi">
			{copy.links.map((l) => (
				<a href={l.href} class="sub-link reveal">
					<strong>{l.title}</strong>
					<span>{l.desc}</span>
				</a>
			))}
		</nav>
		<div class="cta-band reveal">
			<h2>{copy.ctaTitle}</h2>
			<p>{copy.ctaBody}</p>
			<WhatsAppButton message={waMessage} locale={locale} size="lg" />
		</div>
	</div>
</Base>

<style>
	.about {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-brand);
		margin-bottom: var(--spacing-md);
	}
	.statement-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: var(--spacing-2xl);
		align-items: start;
	}
	.statement-grid h1 {
		font-size: clamp(1.9rem, 3.6vw, 2.9rem);
		line-height: 1.25;
		letter-spacing: var(--tracking-tight);
		text-wrap: balance;
	}
	.sidenote {
		padding: var(--spacing-lg);
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
		background: var(--color-surface);
		border-left: 3px solid var(--color-wood);
		border-radius: 0 var(--radius) var(--radius) 0;
	}
	.about-visual {
		margin-top: var(--spacing-2xl);
	}
	.prose {
		max-width: var(--max-width);
		margin-top: var(--spacing-2xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		line-height: var(--leading-relaxed);
	}
	.sub-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-md);
		margin-top: var(--spacing-2xl);
	}
	.sub-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: var(--spacing-lg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}
	.sub-link:hover {
		border-color: var(--color-brand);
	}
	.sub-link span {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.cta-band {
		margin-top: var(--spacing-3xl);
		text-align: center;
		padding: var(--spacing-3xl) var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
	}
	.cta-band p {
		color: var(--color-muted);
	}
	@media (max-width: 900px) {
		.statement-grid,
		.sub-links {
			grid-template-columns: 1fr;
		}
	}
</style>
