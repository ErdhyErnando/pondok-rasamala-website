---
import Base from "../layouts/Base.astro";
import PhotoPlaceholder from "../components/ui/PhotoPlaceholder.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import { localizePath } from "../lib/i18n";

export const prerender = true;

const locale = "id" as const;
const L = (p: string) => localizePath(p, locale);
const copy = {
	title: "Tentang Kami",
	meta: "Pondok Rasamala: resort bambu & kayu bernuansa alam pedesaan di Gunung Salak Endah, dalam Taman Nasional Gunung Halimun Salak.",
	statement: "Resort bernuansa alam pedesaan, bangunan bambu dan kayu yang artistik di tengah hutan Taman Nasional Gunung Halimun Salak.",
	side: "16 unit bungalow · 8 tenda glamping · aula · area outbound, ±90 km dari Jakarta, di ketinggian 1.000–1.200 mdpl.",
	body1:
		"Pondok Rasamala berdiri di kawasan wisata Gunung Salak Endah (Gunung Bunder), Pamijahan, Bogor, di dalam Taman Nasional Gunung Halimun Salak. Setiap unitnya dirancang berbeda dari bambu dan kayu, menyatu dengan taman bunga, saung-saung, dan udara gunung yang sejuk sepanjang hari.",
	body2:
		"Kami melayani liburan keluarga, gathering perusahaan, acara sekolah, dan komunitas, dengan villa berkapasitas 4 sampai 28 orang, glamping untuk 4–10 orang, aula pertemuan, dan lapangan outbound. Semua pemesanan langsung via WhatsApp, tanpa perantara.",
	links: [
		{ href: L("/villa/"), title: "Villa & cottage", desc: "16 unit untuk segala ukuran rombongan" },
		{ href: L("/package/"), title: "Paket & outbound", desc: "Gathering, sekolah, dan keluarga" },
		{ href: L("/location/"), title: "Lokasi & rute", desc: "±2 jam dari Jakarta, ±1,5 jam dari Bogor" },
	],
	ctaTitle: "Rasakan sendiri tenangnya",
	ctaBody: "Ceritakan rencana liburan, kami bantu pilihkan unit yang pas.",
};
const waMessage = "Halo Pondok Rasamala, saya mau bertanya tentang resort. Terima kasih.";
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container about">
		<h1 class="page-title reveal">{copy.title}</h1>
		<div class="about-visual reveal">
			<PhotoPlaceholder label="Suasana resort: foto menyusul" ratio="16 / 8" />
		</div>
		<p class="statement reveal">{copy.statement}</p>
		<div class="prose">
			<p>{copy.body1}</p>
			<p>{copy.body2}</p>
		</div>
		<nav class="sub-links" aria-label="Jelajahi">
			{copy.links.map((l) => (
				<a href={l.href} class="sub-link reveal">
					<span class="sub-text">
						<strong>{l.title}</strong>
						<span>{l.desc}</span>
					</span>
					<span class="sub-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</nav>
		<div class="cta-band reveal">
			<h2>{copy.ctaTitle}</h2>
			<p>{copy.ctaBody}</p>
			<WhatsAppButton message={waMessage} locale={locale} size="lg" />
		</div>
	</div>
</Base>

<style>
	.about {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.page-title {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.about-visual {
		margin-top: var(--spacing-2xl);
	}
	.statement {
		margin-top: var(--spacing-2xl);
		font-size: clamp(1.4rem, 2.6vw, 2rem);
		line-height: 1.25;
		letter-spacing: -0.02em;
		font-weight: 600;
		text-wrap: balance;
		max-width: 24ch;
	}
	.prose {
		max-width: var(--max-width);
		margin-top: var(--spacing-2xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		line-height: var(--leading-relaxed);
	}
	/* Armonia underlined subsection rows. */
	.sub-links {
		margin-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}
	.sub-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: var(--spacing-lg) 0;
		border-bottom: 1px dashed var(--color-border);
	}
	.sub-text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.sub-text strong {
		font-size: var(--font-size-lg);
		font-weight: 600;
		letter-spacing: var(--tracking-snug);
	}
	.sub-link:hover .sub-text strong {
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--color-brand);
	}
	.sub-text span {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.sub-arrow {
		flex-shrink: 0;
		font-size: var(--font-size-lg);
		color: var(--color-brand);
		transition: transform var(--transition-fast);
	}
	.sub-link:hover .sub-arrow {
		transform: translateX(4px);
	}
	.cta-band {
		margin-top: var(--spacing-3xl);
		text-align: center;
		padding: var(--spacing-3xl) var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
	}
	.cta-band h2 {
		font-family: var(--font-heading);
	}
	.cta-band p {
		color: var(--color-muted);
	}
</style>
