---
import StayIndex from "../../components/layout/StayIndex.astro";
import StayCard from "../../components/ui/StayCard.astro";
import Lightbox from "../../components/ui/Lightbox.astro";
import { campsite, campLots } from "../../data/campsite";
import { SITE } from "../../lib/constants";
import { formatIDR } from "../../lib/format";
import { getStrings } from "../../lib/i18n";

export const prerender = true;

const locale = "id" as const;
const copy = {
	title: "Semua Campsite",
	description:
		"Enam lot campsite dan enam Riverside Camp tepi sungai di kaki Gunung Salak, tenda dan makan pagi sudah disiapkan. Klik lot untuk cek ketersediaan live.",
	meta: "Semua campsite Pondok Rasamala: 6 lot campsite + 6 Riverside Camp tepi sungai, harga per tier pax. Cek ketersediaan live.",
	ratesTitle: "Harga per lot",
	priceNote: "Harga konfirmasi via WhatsApp",
	cta: "Cek ketersediaan",
	photo: "foto menyusul",
};
const photoCopy = { title: "Suasana campsite", close: "Tutup" };
const ui = getStrings(locale).actions;
const photoItems = [campsite.hero, ...campsite.gallery].map((p) => ({ label: p.alt[locale], photo: p }));
// Strip: 1200 px container with 24 px padding, 3 columns with 16 px gaps (2 under 601 px).
const stripSizes = "(min-width: 1200px) 373px, (min-width: 601px) calc((100vw - 80px) / 3), calc((100vw - 64px) / 2)";
const riversideBlurb = "Berkemah tepi sungai, klik untuk cek ketersediaan lot.";
---

<StayIndex locale={locale} title={copy.title} description={copy.description} meta={copy.meta} ctaKind="campsite">
	{campLots.map((lot) => (
		<StayCard
			href={SITE.availability}
			external
			name={lot.name}
			blurb={lot.area === "riverside" ? riversideBlurb : campsite.tagline[locale]}
			imageLabel={`${lot.name}: ${copy.photo}`}
			cta={copy.cta}
		/>
	))}
	<section class="photos" slot="after">
		<h2>{photoCopy.title}</h2>
		<Lightbox
			items={photoItems}
			locale={locale}
			stripSizes={stripSizes}
			closeLabel={photoCopy.close}
			prevLabel={ui.previousPhoto}
			nextLabel={ui.nextPhoto}
		/>
	</section>
	<section class="rates" slot="after">
		<h2>{copy.ratesTitle}</h2>
		<dl class="rate-list">
			{campsite.tiers.map((tier) => (
				<div class="rate-row">
					<dt>{tier.pax} orang / malam</dt>
					<dd>{formatIDR(tier.price)}</dd>
				</div>
			))}
		</dl>
		<p class="price-note">{copy.priceNote}</p>
	</section>
</StayIndex>

<style>
	.photos {
		margin-top: var(--spacing-3xl);
	}
	.photos h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		letter-spacing: -0.02em;
		margin-bottom: var(--spacing-md);
	}
	.rates {
		margin-top: var(--spacing-3xl);
		max-width: 40rem;
	}
	.rates h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		letter-spacing: -0.02em;
	}
	.rate-list {
		margin-top: var(--spacing-md);
		border-top: 1px solid var(--color-text);
	}
	.rate-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: var(--spacing-md) 0;
		border-bottom: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
	}
	.rate-row dt {
		color: var(--color-muted);
	}
	.rate-row dd {
		margin: 0;
		font-weight: 600;
	}
	.price-note {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
</style>
