---
import Base from "../layouts/Base.astro";
import MapFacade from "../components/ui/MapFacade.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import { SITE } from "../lib/constants";

export const prerender = true;

const locale = "id" as const;
const copy = {
	title: "Hubungi Kami",
	eyebrow: "Kontak",
	meta: "Hubungi Pondok Rasamala: WhatsApp, telepon, email, alamat, dan media sosial. Tanpa formulir, langsung terhubung.",
	description: "Tanpa formulir, tanpa antre, langsung terhubung ke tim kami.",
	waTitle: "WhatsApp (tercepat)",
	phoneTitle: "Telepon",
	addressTitle: "Alamat",
	socialTitle: "Media sosial",
	hours: "Setiap hari, 08.00–20.00 WIB",
	mapLabel: "Muat peta",
};
const waMessage = "Halo Pondok Rasamala, saya mau bertanya. Terima kasih.";
const socials = [
	{ href: SITE.socials.instagram, label: "Instagram" },
	{ href: SITE.socials.tiktok, label: "TikTok" },
	{ href: SITE.socials.youtube, label: "YouTube" },
	{ href: SITE.socials.facebook, label: "Facebook" },
];
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<h1 class="page-title reveal">{copy.title}</h1>
		<p class="lede reveal">{copy.description}</p>
		<div class="contact-grid">
			<div class="contact-info">
				<article class="info-card reveal">
					<h2>{copy.waTitle}</h2>
					<p class="big">+{SITE.whatsapp}</p>
					<WhatsAppButton message={waMessage} locale={locale} />
				</article>
				<article class="info-card reveal">
					<h2>{copy.phoneTitle}</h2>
					<ul>
						{SITE.phones.map((p) => <li><a href={`tel:+62${p.replace(/\D/g, "").slice(1)}`}>{p}</a></li>)}
						<li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
					</ul>
					<p class="hours">{copy.hours}</p>
				</article>
				<article class="info-card reveal">
					<h2>{copy.addressTitle}</h2>
					<address>{SITE.address}</address>
					<p class="hours">
						<a
							href={SITE.mapsUrl}
							target="_blank"
							rel="noopener">Buka di Google Maps →</a
						>
					</p>
				</article>
				<article class="info-card reveal">
					<h2>{copy.socialTitle}</h2>
					<ul class="socials">
						{socials.map((s) => (
							<li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>
						))}
					</ul>
				</article>
			</div>
			<div class="map-wrap reveal">
				<MapFacade loadLabel={copy.mapLabel} auto />
			</div>
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.page-title {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.lede {
		margin-top: var(--spacing-md);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		max-width: 52ch;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: var(--spacing-xl);
		align-items: stretch;
		margin-top: var(--spacing-3xl);
	}
	.contact-info {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}
	.info-card {
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.info-card h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--spacing-sm);
	}
	.big {
		font-size: var(--font-size-2xl);
		font-weight: 700;
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-md);
	}
	.info-card ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}
	.info-card a {
		color: var(--color-brand);
		font-weight: 600;
	}
	.hours {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.info-card address {
		font-style: normal;
		line-height: var(--leading-relaxed);
	}
	.socials {
		flex-direction: row !important;
		flex-wrap: wrap;
		gap: var(--spacing-md) !important;
	}
	.map-wrap {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
	}
	.map-wrap :global(.map-facade) {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		flex: 1;
		min-height: min(70vh, 560px);
	}
	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
		.map-wrap {
			position: static;
		}
	}
</style>
