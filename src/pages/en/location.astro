---
import Base from "../../layouts/Base.astro";
import MapFacade from "../../components/ui/MapFacade.astro";
import { SITE } from "../../lib/constants";

export const prerender = true;

const locale = "en" as const;

// About-style rhythm: eyebrow + statement + sidenote, then quiet
// numbered route columns and hairline note rows.
const copy = {
	title: "Location & Directions",
	eyebrow: "Getting here",
	meta: "Routes to Pondok Rasamala from Jakarta & Bogor: via Sentul Selatan toll, BORR, Dramaga IPB. ±90 km from Jakarta, ±30 km from Bogor city.",
	statement:
		"In the Gunung Salak Endah tourism area, Pamijahan, Bogor, wrapped in national-park forest.",
	side: "±90 km from Jakarta · ±30 km from Bogor city · bus parking available.",
	routes: [
		{
			title: "From Jakarta (±2 hours)",
			steps: [
				"Exit the Jagorawi toll at Sentul Selatan, join the Bogor Outer Ring Road (BORR) toward Kedung Badak.",
				"Exit BORR onto Jalan Baru (Jl. KH Soleh Iskandar) toward Dramaga / IPB Campus.",
				"Pass IPB Dramaga for ±4 km, find the Cikampak junction (Indomaret–Alfamart landmark), turn left.",
				"Follow the road into the Gunung Salak Endah tourism area to Pondok Rasamala's gate.",
			],
		},
		{
			title: "From Bogor (±1.5 hours)",
			steps: [
				"From central Bogor head to Dramaga / IPB Campus (±30 km to the area).",
				"Continue to the Cikampak junction, turn toward Gunung Salak Endah.",
				"Follow the area's main road to Pondok Rasamala.",
			],
		},
	],
	transportTitle: "Public transport",
	transport: [
		"Curug Luhur-bound buses from Bogor pass through Gunung Bunder.",
		"From the drop point, take a local ojek to the resort gate.",
		"Large groups should bring their own bus, parking available.",
	],
	tipsTitle: "Travel tips",
	tips: [
		"Leave early to beat Jagorawi & Sentul traffic.",
		"Mobile signal drops in spots, download offline maps.",
		"The final stretch climbs; check brakes & fuel.",
	],
	verify: "Routes from web archives & traveller blogs, please correct via WhatsApp if anything changed.",
	mapLabel: "Load map",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<h1 class="page-title reveal">{copy.title}</h1>
		<p class="statement reveal">{copy.statement}</p>
		<div class="split-grid">
			<div class="info-stack">
				{copy.routes.map((r, i) => (
					<article class="info-card reveal">
						<span class="row-index" aria-hidden="true">
							{String(i + 1).padStart(2, "0")}
						</span>
						<h2>{r.title}</h2>
						<ol>
							{r.steps.map((s) => <li>{s}</li>)}
						</ol>
					</article>
				))}
				<article class="info-card reveal">
					<h2>{copy.transportTitle}</h2>
					<ul>
						{copy.transport.map((item) => <li>{item}</li>)}
					</ul>
				</article>
				<article class="info-card reveal">
					<h2>{copy.tipsTitle}</h2>
					<ul>
						{copy.tips.map((item) => <li>{item}</li>)}
					</ul>
				</article>
				<p class="verify-note reveal">{copy.verify}</p>
			</div>
			<div class="map-wrap reveal">
				<MapFacade loadLabel={copy.mapLabel} auto />
				<p class="map-link">
					<a href={SITE.mapsUrl} target="_blank" rel="noopener"
						>Open in Google Maps →</a
					>
				</p>
			</div>
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.page-title {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.statement {
		margin-top: var(--spacing-md);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		max-width: 52ch;
	}
	.split-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: var(--spacing-xl);
		align-items: stretch;
		margin-top: var(--spacing-3xl);
	}
	.info-stack {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}
	.info-card {
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.info-card h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		letter-spacing: var(--tracking-snug);
		margin-top: var(--spacing-sm);
	}
	.row-index {
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		letter-spacing: 0.08em;
	}
	.info-card ol {
		margin-top: var(--spacing-md);
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
	}
	.info-card ul {
		margin-top: var(--spacing-md);
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
	}
	.verify-note {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		font-style: italic;
	}
	.map-wrap {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
	}
	.map-wrap :global(.map-facade) {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		flex: 1;
		min-height: min(70vh, 560px);
	}
	.map-link {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
	}
	.map-link a {
		color: var(--color-brand);
		font-weight: 600;
	}
	@media (max-width: 900px) {
		.split-grid {
			grid-template-columns: 1fr;
		}
		.map-wrap {
			position: static;
		}
	}
</style>
