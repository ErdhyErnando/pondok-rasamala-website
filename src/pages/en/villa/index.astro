---
import Base from "../../../layouts/Base.astro";
import SectionHeader from "../../../components/ui/SectionHeader.astro";
import VillaCard from "../../../components/ui/VillaCard.astro";
import { isVillaCategory, villas, villaPath } from "../../../data/villas";
import { formatIDR } from "../../../lib/format";
import { localizePath } from "../../../lib/i18n";
import { displayName } from "../../../lib/stay";

export const prerender = true;

const locale = "en" as const;
const L = (p: string) => localizePath(p, locale);
const rows = villas.filter(isVillaCategory);
const copy = {
	title: "All Villas",
	eyebrow: "Stay",
	description:
		"Bamboo and timber villas inside Gunung Halimun Salak National Park, from cosy ones for small families to Villa Cendana for 28 guests.",
	meta: "All Pondok Rasamala villas: bamboo, timber, and cottage units, nightly rates, capacity. Book via WhatsApp.",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container index-head">
		<SectionHeader
			eyebrow={copy.eyebrow}
			title={copy.title}
			description={copy.description}
			align="left"
		/>
		<div class="card-grid">
			{rows.map((v) => (
				<VillaCard
					href={L(villaPath(v.slug))}
					name={displayName("villa", v.name)}
					eyebrow={`Villa · sleeps ${v.paxMax}`}
					price={formatIDR(v.price)}
					priceNote="Price confirmed via WhatsApp"
					blurb={v.tagline.en}
					imageLabel={`${displayName("villa", v.name)}: photo to follow`}
				/>
			))}
		</div>
	</div>
</Base>

<style>
	.index-head {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	/* Compact editorial: three cards per row, full container width so the
	   grid aligns with the header, deep gaps for breathing room. */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-3xl);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-3xl);
	}
	@media (max-width: 1100px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 700px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
