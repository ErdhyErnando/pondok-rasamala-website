---
import StayIndex from "../../../components/layout/StayIndex.astro";
import StayCard from "../../../components/ui/StayCard.astro";
import { getVillaCards, getSizeBuckets } from "../../../lib/stay";

export const prerender = true;

const locale = "en" as const;
const copy = {
	title: "All Villas",
	description:
		"Bamboo and timber villas inside Gunung Halimun Salak National Park, from cosy ones for small families to Villa Cendana for 28 guests.",
	meta: "All Pondok Rasamala villas: bamboo, timber, and cottage units, nightly rates, capacity. Book via WhatsApp.",
};
const cards = getVillaCards(locale);
const sizes = getSizeBuckets("villa", locale);
---

<StayIndex locale={locale} title={copy.title} description={copy.description} meta={copy.meta} ctaKind="villa" sizes={sizes}>
	{cards.map((c) => (
		<StayCard href={c.href} name={c.name} blurb={c.blurb} imageLabel={c.imageLabel} facts={c.facts} paxMin={c.paxMin} paxMax={c.paxMax} minPrice={c.minPrice} />
	))}
</StayIndex>
