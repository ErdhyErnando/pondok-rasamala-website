---
import Base from "../../../layouts/Base.astro";
import SectionHeader from "../../../components/ui/SectionHeader.astro";
import PackageCard from "../../../components/ui/PackageCard.astro";
import { packages, packagePath } from "../../../data/packages";
import { formatIDR } from "../../../lib/format";
import { localizePath } from "../../../lib/i18n";

export const prerender = true;

const locale = "en" as const;
const L = (p: string) => localizePath(p, locale);
const copy = {
	title: "All Packages",
	eyebrow: "Gatherings & activities",
	meta: "Pondok Rasamala packages: outbound, school, company outing, family. Per-person rates & custom quotes via WhatsApp.",
	description: "From one-day outbound to stay-over gatherings — all arranged from one place.",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<SectionHeader
			eyebrow={copy.eyebrow}
			title={copy.title}
			description={copy.description}
		/>
		<div class="card-grid">
			{packages.map((p) => (
				<PackageCard
					href={L(packagePath(p.slug))}
					name={p.name.en}
					tagline={p.tagline.en}
					duration={p.duration.en}
					priceSummary={
						p.tiers[0]?.price != null
							? `From ${formatIDR(Math.min(...p.tiers.map((tier) => tier.price as number)))}`
							: "Custom quote"
					}
					imageLabel={`${p.name.en} — photo to follow`}
				/>
			))}
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-2xl) var(--spacing-xl);
	}
	@media (max-width: 700px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
