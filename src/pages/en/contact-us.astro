---
import Base from "../../layouts/Base.astro";
import MapFacade from "../../components/ui/MapFacade.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import WhatsAppButton from "../../components/ui/WhatsAppButton.astro";
import { SITE } from "../../lib/constants";

export const prerender = true;

const locale = "en" as const;
const mapsQuery = encodeURIComponent("Pondok Rasamala, Gunung Salak Endah, Pamijahan, Bogor");
const copy = {
	title: "Contact Us",
	eyebrow: "Contact",
	meta: "Contact Pondok Rasamala: WhatsApp, phone, email, address, and socials. No forms — straight through to our team.",
	description: "No forms, no queues — straight through to our team.",
	waTitle: "WhatsApp (fastest)",
	phoneTitle: "Phone",
	addressTitle: "Address",
	socialTitle: "Socials",
	hours: "Daily, 08.00–20.00 WIB",
	mapLabel: "Load map",
};
const waMessage = "Hello Pondok Rasamala, I'd like to ask something. Thank you.";
const socials = [
	{ href: SITE.socials.instagram, label: "Instagram" },
	{ href: SITE.socials.tiktok, label: "TikTok" },
	{ href: SITE.socials.youtube, label: "YouTube" },
	{ href: SITE.socials.facebook, label: "Facebook" },
];
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<SectionHeader
			eyebrow={copy.eyebrow}
			title={copy.title}
			description={copy.description}
		/>
		<div class="contact-grid">
			<div class="contact-info">
				<article class="info-card reveal">
					<h2>{copy.waTitle}</h2>
					<p class="big">+{SITE.whatsapp}</p>
					<WhatsAppButton message={waMessage} locale={locale} />
				</article>
				<article class="info-card reveal">
					<h2>{copy.phoneTitle}</h2>
					<ul>
						{SITE.phones.map((p) => <li><a href={`tel:+62${p.replace(/\D/g, "").slice(1)}`}>{p}</a></li>)}
						<li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
					</ul>
					<p class="hours">{copy.hours}</p>
				</article>
				<article class="info-card reveal">
					<h2>{copy.addressTitle}</h2>
					<address>{SITE.address}</address>
					<p class="hours">
						<a
							href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`}
							target="_blank"
							rel="noopener">Open in Google Maps →</a
						>
					</p>
				</article>
				<article class="info-card reveal">
					<h2>{copy.socialTitle}</h2>
					<ul class="socials">
						{socials.map((s) => (
							<li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>
						))}
					</ul>
				</article>
			</div>
			<div class="map-wrap reveal">
				<MapFacade loadLabel={copy.mapLabel} />
			</div>
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: var(--spacing-xl);
		align-items: start;
	}
	.contact-info {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}
	.info-card {
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.info-card h2 {
		font-size: var(--font-size-base);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--spacing-sm);
	}
	.big {
		font-size: var(--font-size-2xl);
		font-weight: 700;
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-md);
	}
	.info-card ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}
	.info-card a {
		color: var(--color-brand);
		font-weight: 600;
	}
	.hours {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.info-card address {
		font-style: normal;
		line-height: var(--leading-relaxed);
	}
	.socials {
		flex-direction: row !important;
		flex-wrap: wrap;
		gap: var(--spacing-md) !important;
	}
	.map-wrap :global(.map-facade) {
		border: 1px solid var(--color-border);
		min-height: 100%;
	}
	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
