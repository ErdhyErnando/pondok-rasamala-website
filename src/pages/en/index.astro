---
import Base from "../../layouts/Base.astro";
import AccommodationShowcase from "../../components/sections/AccommodationShowcase.astro";
import ActivitySection from "../../components/sections/ActivitySection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import LocationSection from "../../components/sections/LocationSection.astro";
import TestimonialsSection from "../../components/sections/TestimonialsSection.astro";
import { SITE } from "../../lib/constants";
import { homeMeta, tx } from "../../data/home";

export const prerender = true;

const locale = "en" as const;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "LodgingBusiness",
	name: SITE.name,
	slogan: SITE.tagline,
	url: SITE.url,
	telephone: `+${SITE.whatsapp}`,
	email: SITE.email,
	address: {
		"@type": "PostalAddress",
		streetAddress: "Jl. Raya Gunung Salak Endah, Kec. Pamijahan",
		addressLocality: "Kab. Bogor",
		addressRegion: "West Java",
		addressCountry: "ID",
	},
	sameAs: Object.values(SITE.socials),
};
---

<Base
	title={tx(homeMeta.title, locale).split(" — ")[1]}
	description={tx(homeMeta.description, locale)}
	locale={locale}
	jsonLd={jsonLd}
>
	<HeroSection locale={locale} />
	<AccommodationShowcase locale={locale} />
	<ActivitySection locale={locale} />
	<TestimonialsSection locale={locale} />
	<LocationSection locale={locale} />
	<CTASection locale={locale} />
</Base>
