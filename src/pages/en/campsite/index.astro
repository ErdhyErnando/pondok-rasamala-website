---
import StayIndex from "../../../components/layout/StayIndex.astro";
import StayCard from "../../../components/ui/StayCard.astro";
import { campsite, campLots } from "../../../data/campsite";
import { SITE } from "../../../lib/constants";
import { formatIDR } from "../../../lib/format";

export const prerender = true;

const locale = "en" as const;
const copy = {
	title: "All Campsites",
	description:
		"Six campsite lots and six Riverside Camps by the river at the foot of Mount Salak, tents and breakfast ready. Open a lot to check live availability.",
	meta: "All Pondok Rasamala campsites: 6 campsite lots + 6 Riverside Camps by the river, tiered per-pax rates. Check live availability.",
	ratesTitle: "Rates per lot",
	priceNote: "Price confirmed via WhatsApp",
	cta: "Check availability",
	photo: "photo to follow",
};
const riversideBlurb = "Camp by the river, open to check lot availability.";
---

<StayIndex locale={locale} title={copy.title} description={copy.description} meta={copy.meta} ctaKind="campsite">
	{campLots.map((lot) => (
		<StayCard
			href={SITE.availability}
			external
			name={lot.name}
			blurb={lot.area === "riverside" ? riversideBlurb : campsite.tagline[locale]}
			imageLabel={`${lot.name}: ${copy.photo}`}
			cta={copy.cta}
		/>
	))}
	<section class="rates" slot="after">
		<h2>{copy.ratesTitle}</h2>
		<dl class="rate-list">
			{campsite.tiers.map((tier) => (
				<div class="rate-row">
					<dt>{tier.pax} guests / night</dt>
					<dd>{formatIDR(tier.price)}</dd>
				</div>
			))}
		</dl>
		<p class="price-note">{copy.priceNote}</p>
	</section>
</StayIndex>

<style>
	.rates {
		margin-top: var(--spacing-3xl);
		max-width: 40rem;
	}
	.rates h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		letter-spacing: -0.02em;
	}
	.rate-list {
		margin-top: var(--spacing-md);
		border-top: 1px solid var(--color-text);
	}
	.rate-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: var(--spacing-md) 0;
		border-bottom: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
	}
	.rate-row dt {
		color: var(--color-muted);
	}
	.rate-row dd {
		margin: 0;
		font-weight: 600;
	}
	.price-note {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
</style>
