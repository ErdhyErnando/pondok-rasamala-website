---
import Base from "../../../layouts/Base.astro";
import SectionHeader from "../../../components/ui/SectionHeader.astro";
import GlampingCard from "../../../components/ui/GlampingCard.astro";
import { glamping, glampingPath } from "../../../data/glamping";
import { formatIDR } from "../../../lib/format";
import { localizePath } from "../../../lib/i18n";

export const prerender = true;

const locale = "en" as const;
const L = (p: string) => localizePath(p, locale);
const copy = {
	title: "All Glamping",
	eyebrow: "Stay",
	description:
		"8 glamping tents named after West Java mountains — warm mattresses, private bathroom, breakfast, and bonfire included.",
	meta: "All Pondok Rasamala glamping: 8 tents, per-pax tier pricing, breakfast & bonfire included. Book via WhatsApp.",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container index-head">
		<SectionHeader
			eyebrow={copy.eyebrow}
			title={copy.title}
			description={copy.description}
		/>
		<div class="card-grid">
			{glamping.map((g) => {
				const min = Math.min(...g.tiers.map((tier) => tier.price));
				const pax = g.tiers.map((tier) => tier.pax);
				return (
					<GlampingCard
						href={L(glampingPath(g.slug))}
						name={`Glamping ${g.name}`}
						eyebrow={`Glamping · ${Math.min(...pax)}–${Math.max(...pax)} guests`}
						fromPrice={`From ${formatIDR(min)}`}
						priceNote="Price confirmed via WhatsApp"
						blurb={g.tagline.en}
						imageLabel={`Glamping ${g.name} — photo to follow`}
					/>
				);
			})}
		</div>
	</div>
</Base>

<style>
	.index-head {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-2xl) var(--spacing-xl);
	}
	@media (max-width: 960px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
