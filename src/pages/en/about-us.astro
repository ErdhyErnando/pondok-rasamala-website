---
import Base from "../../layouts/Base.astro";
import PhotoPlaceholder from "../../components/ui/PhotoPlaceholder.astro";
import WhatsAppButton from "../../components/ui/WhatsAppButton.astro";
import { localizePath } from "../../lib/i18n";

export const prerender = true;

const locale = "en" as const;
const L = (p: string) => localizePath(p, locale);
const copy = {
	title: "About Us",
	meta: "Pondok Rasamala: a bamboo & timber countryside resort in Gunung Salak Endah, inside Gunung Halimun Salak National Park.",
	statement: "A countryside nature resort, artistic bamboo and timber buildings deep in Gunung Halimun Salak National Park's forest.",
	side: "16 bungalow units · 8 glamping tents · hall · outbound grounds, ±90 km from Jakarta, at 1,000–1,200 m altitude.",
	body1:
		"Pondok Rasamala stands in the Gunung Salak Endah (Gunung Bunder) tourism area, Pamijahan, Bogor, inside Gunung Halimun Salak National Park. Every unit is distinctly designed from bamboo and timber, blending into flower gardens, pavilions, and cool mountain air all day.",
	body2:
		"We host family holidays, company gatherings, school events, and communities, with villas for 4 to 28 guests, glamping for 4–10, a meeting hall, and outbound fields. All bookings direct via WhatsApp, no middlemen.",
	links: [
		{ href: L("/villa/"), title: "Villas & cottages", desc: "16 units for every group size" },
		{ href: L("/package/"), title: "Packages & outbound", desc: "Gatherings, schools, and families" },
		{ href: L("/location/"), title: "Location & routes", desc: "±2 hours from Jakarta, ±1.5 from Bogor" },
	],
	ctaTitle: "Feel the calm yourself",
	ctaBody: "Tell us your holiday plan, we'll help you pick the right unit.",
};
const waMessage = "Hello Pondok Rasamala, I'd like to ask about the resort. Thank you.";
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container about">
		<h1 class="page-title reveal">{copy.title}</h1>
		<div class="about-visual reveal">
			<PhotoPlaceholder label="Resort atmosphere: photo to follow" ratio="16 / 8" />
		</div>
		<p class="statement reveal">{copy.statement}</p>
		<div class="prose">
			<p>{copy.body1}</p>
			<p>{copy.body2}</p>
		</div>
		<nav class="sub-links" aria-label="Explore">
			{copy.links.map((l) => (
				<a href={l.href} class="sub-link reveal">
					<span class="sub-text">
						<strong>{l.title}</strong>
						<span>{l.desc}</span>
					</span>
					<span class="sub-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</nav>
		<div class="cta-band reveal">
			<h2>{copy.ctaTitle}</h2>
			<p>{copy.ctaBody}</p>
			<WhatsAppButton message={waMessage} locale={locale} size="lg" />
		</div>
	</div>
</Base>

<style>
	.about {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.page-title {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.about-visual {
		margin-top: var(--spacing-2xl);
	}
	.statement {
		margin-top: var(--spacing-2xl);
		font-size: clamp(1.4rem, 2.6vw, 2rem);
		line-height: 1.25;
		letter-spacing: -0.02em;
		font-weight: 600;
		text-wrap: balance;
		max-width: 24ch;
	}
	.prose {
		max-width: var(--max-width);
		margin-top: var(--spacing-2xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		line-height: var(--leading-relaxed);
	}
	/* Armonia underlined subsection rows. */
	.sub-links {
		margin-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}
	.sub-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: var(--spacing-lg) 0;
		border-bottom: 1px dashed var(--color-border);
	}
	.sub-text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.sub-text strong {
		font-size: var(--font-size-lg);
		font-weight: 600;
		letter-spacing: var(--tracking-snug);
	}
	.sub-link:hover .sub-text strong {
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--color-brand);
	}
	.sub-text span {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.sub-arrow {
		flex-shrink: 0;
		font-size: var(--font-size-lg);
		color: var(--color-brand);
		transition: transform var(--transition-fast);
	}
	.sub-link:hover .sub-arrow {
		transform: translateX(4px);
	}
	.cta-band {
		margin-top: var(--spacing-3xl);
		text-align: center;
		padding: var(--spacing-3xl) var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
	}
	.cta-band h2 {
		font-family: var(--font-heading);
	}
	.cta-band p {
		color: var(--color-muted);
	}
</style>
