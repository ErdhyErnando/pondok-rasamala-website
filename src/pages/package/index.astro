---
import Base from "../../layouts/Base.astro";
import IndexHead from "../../components/layout/IndexHead.astro";
import PackageCard from "../../components/ui/PackageCard.astro";
import { packages } from "../../data/packages";
import { packageCardProps } from "../../lib/packages";

export const prerender = true;

const locale = "id" as const;
const copy = {
	title: "Semua Paket",
	meta: "Paket Pondok Rasamala: outbound, sekolah, company outing, keluarga. Harga per orang & penawaran khusus via WhatsApp.",
	description: "Dari outbound sehari sampai gathering menginap, semua diatur dari satu pintu.",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<IndexHead title={copy.title} description={copy.description} />
		<div class="pk-grid">
			{packages.map((p) => (
				<PackageCard {...packageCardProps(p, locale)} />
			))}
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: clamp(3rem, 6vw, 6rem);
		padding-bottom: var(--section-pad);
	}
	.pk-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-3xl) var(--spacing-xl);
	}
	@media (max-width: 900px) {
		.pk-grid {
			grid-template-columns: 1fr;
		}
	}
	/* First row sits in the first viewport: no reveal there (2/1 columns). */
	@media (min-width: 901px) {
		.pk-grid > :global(.pk:nth-child(-n + 2)) {
			animation: none;
		}
	}
	@media (max-width: 900px) {
		.pk-grid > :global(.pk:nth-child(1)) {
			animation: none;
		}
	}
</style>
