---
import Base from "../layouts/Base.astro";
import MapFacade from "../components/ui/MapFacade.astro";
import { SITE } from "../lib/constants";

export const prerender = true;

const locale = "id" as const;

// About-style rhythm: eyebrow + statement + sidenote, then quiet
// numbered route columns and hairline note rows.
const copy = {
	title: "Lokasi & Rute",
	eyebrow: "Menuju ke sini",
	meta: "Rute ke Pondok Rasamala dari Jakarta & Bogor: via Tol Sentul Selatan, BORR, Dramaga IPB. ±90 km dari Jakarta, ±30 km dari Kota Bogor.",
	statement:
		"Di kawasan wisata Gunung Salak Endah, Pamijahan, Bogor, dikelilingi hutan Taman Nasional.",
	side: "±90 km dari Jakarta · ±30 km dari Kota Bogor · parkir bus tersedia.",
	routes: [
		{
			title: "Dari Jakarta (±2 jam)",
			steps: [
				"Keluar Tol Jagorawi di Sentul Selatan, masuk Tol Lingkar Luar Bogor (BORR) arah Kedung Badak.",
				"Keluar BORR, ambil arah Jalan Baru (Jl. KH Soleh Iskandar) menuju Dramaga / Kampus IPB.",
				"Lewati Kampus IPB Dramaga ±4 km, cari pertigaan Cikampak (patokan Indomaret–Alfamart berhadapan), belok kiri.",
				"Ikuti jalan menuju kawasan wisata Gunung Salak Endah sampai gerbang Pondok Rasamala.",
			],
		},
		{
			title: "Dari Bogor (±1,5 jam)",
			steps: [
				"Dari pusat Kota Bogor menuju Dramaga / Kampus IPB (±30 km ke kawasan).",
				"Lanjut ke pertigaan Cikampak, belok menuju kawasan wisata Gunung Salak Endah.",
				"Ikuti jalan utama kawasan sampai Pondok Rasamala.",
			],
		},
	],
	transportTitle: "Kendaraan umum",
	transport: [
		"Bus jurusan Curug Luhur dari Bogor melewati kawasan Gunung Bunder.",
		"Dari titik turun, lanjut ojek lokal sampai gerbang resort.",
		"Rombongan besar disarankan bawa bus sendiri, parkir tersedia.",
	],
	tipsTitle: "Tips perjalanan",
	tips: [
		"Berangkat pagi untuk menghindari macet Jagorawi & Sentul.",
		"Sinyal seluler melemah di beberapa titik, unduh peta offline.",
		"Jalan menanjak di segmen akhir; pastikan rem & bahan bakar aman.",
	],
	verify: "Rute dari arsip web & blog wisatawan, mohon koreksi via WhatsApp bila ada perubahan.",
	mapLabel: "Muat peta",
};
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<h1 class="page-title reveal">{copy.title}</h1>
		<p class="statement reveal">{copy.statement}</p>
		<div class="split-grid">
			<div class="info-stack">
				{copy.routes.map((r, i) => (
					<article class="info-card reveal">
						<span class="row-index" aria-hidden="true">
							{String(i + 1).padStart(2, "0")}
						</span>
						<h2>{r.title}</h2>
						<ol>
							{r.steps.map((s) => <li>{s}</li>)}
						</ol>
					</article>
				))}
				<article class="info-card reveal">
					<h2>{copy.transportTitle}</h2>
					<ul>
						{copy.transport.map((item) => <li>{item}</li>)}
					</ul>
				</article>
				<article class="info-card reveal">
					<h2>{copy.tipsTitle}</h2>
					<ul>
						{copy.tips.map((item) => <li>{item}</li>)}
					</ul>
				</article>
				<p class="verify-note reveal">{copy.verify}</p>
			</div>
			<div class="map-wrap reveal">
				<MapFacade loadLabel={copy.mapLabel} auto />
				<p class="map-link">
					<a href={SITE.mapsUrl} target="_blank" rel="noopener"
						>Buka di Google Maps →</a
					>
				</p>
			</div>
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
	}
	.page-title {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.statement {
		margin-top: var(--spacing-md);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		max-width: 52ch;
	}
	.split-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: var(--spacing-xl);
		align-items: stretch;
		margin-top: var(--spacing-3xl);
	}
	.info-stack {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}
	.info-card {
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.info-card h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		letter-spacing: var(--tracking-snug);
		margin-top: var(--spacing-sm);
	}
	.row-index {
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		letter-spacing: 0.08em;
	}
	.info-card ol {
		margin-top: var(--spacing-md);
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
	}
	.info-card ul {
		margin-top: var(--spacing-md);
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
	}
	.verify-note {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		font-style: italic;
	}
	.map-wrap {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
	}
	.map-wrap :global(.map-facade) {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		flex: 1;
		min-height: min(70vh, 560px);
	}
	.map-link {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
	}
	.map-link a {
		color: var(--color-brand);
		font-weight: 600;
	}
	@media (max-width: 900px) {
		.split-grid {
			grid-template-columns: 1fr;
		}
		.map-wrap {
			position: static;
		}
	}
</style>
