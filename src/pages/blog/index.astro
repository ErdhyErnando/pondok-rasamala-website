---
import Base from "../../layouts/Base.astro";
import PhotoPlaceholder from "../../components/ui/PhotoPlaceholder.astro";
import { posts, postPath } from "../../data/posts";
import { localizePath } from "../../lib/i18n";

export const prerender = true;

const locale = "id" as const;
const L = (p: string) => localizePath(p, locale);

// Quiet grotesque list: small-type rows, generous leading, serif
// titles, hairline dividers. No photos, the words carry it.
const copy = {
	title: "Blog",
	eyebrow: "Cerita & panduan",
	meta: "Blog Pondok Rasamala: panduan camping, villa, curug, dan cerita dari kaki Gunung Salak.",
	description: "Panduan praktis dan cerita dari kaki Gunung Salak.",
};
const fmt = (d: string) =>
	new Date(d + "T00:00:00").toLocaleDateString("id-ID", {
		day: "numeric",
		month: "long",
		year: "numeric",
	});
---

<Base title={copy.title} description={copy.meta} locale={locale}>
	<div class="container page">
		<div class="blog-head">
			<h1 class="reveal">{copy.title}</h1>
		</div>
		<div class="page-visual reveal">
			<PhotoPlaceholder label="Blog: foto menyusul" ratio="16 / 8" />
		</div>
		<p class="lede reveal">{copy.description}</p>
		<div class="post-rows">
			{posts.map((p) => (
				<article class="post-row reveal">
					<div class="row-visual" aria-hidden="true">
						<PhotoPlaceholder label={`${p.title.id}: foto menyusul`} ratio="16 / 10" />
					</div>
					<div class="row-body">
						<p class="row-eyebrow">{p.category.id} · {fmt(p.pubDate)}</p>
						<h2><a href={L(postPath(p.slug))}>{p.title.id}</a></h2>
						<p class="row-excerpt">{p.excerpt.id}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</Base>

<style>
	.page {
		padding-top: var(--section-pad);
		padding-bottom: var(--section-pad);
		max-width: 880px;
	}
	.blog-head h1 {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.page-visual {
		margin-top: var(--spacing-2xl);
	}
	.lede {
		margin-top: var(--spacing-2xl);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		max-width: 52ch;
	}
	.post-rows {
		margin-top: var(--spacing-3xl);
		border-top: 1px solid var(--color-border);
	}
	.post-row {
		position: relative;
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: var(--spacing-xl);
		align-items: start;
		padding: var(--spacing-xl) 0;
		border-bottom: 1px dashed var(--color-border);
	}
	.row-visual :global(.photo-placeholder) {
		border-radius: var(--radius);
	}
	.row-eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-brand);
	}
	.post-row h2 {
		font-family: var(--font-heading);
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-2xl);
		letter-spacing: var(--tracking-snug);
		line-height: 1.25;
		text-wrap: balance;
		max-width: 28ch;
	}
	.post-row h2 a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.post-row:hover h2 {
		color: var(--color-brand);
	}
	.row-excerpt {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		max-width: 60ch;
	}
	@media (max-width: 700px) {
		.post-row {
			grid-template-columns: 1fr;
		}
	}
</style>
