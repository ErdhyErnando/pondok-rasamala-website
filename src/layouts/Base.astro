---
import { getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { SITE } from "../lib/constants";
import { getStrings, localizePath, type Locale } from "../lib/i18n";
import "../styles/tokens.css";
import "../styles/theme.css";

// Calm-premium shell: locale-aware head (hreflang id/en/x-default, OG,
// JSON-LD slots), frosted Navbar, deep-forest Footer, CSS-only reveals.
// EmDash wiring kept for admin-published titles/settings; visual chrome
// is data-file + i18n driven.
interface Props {
	title?: string;
	description?: string;
	image?: string;
	locale?: Locale;
	canonical?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, image, locale = "id", canonical, jsonLd } = Astro.props;
const t = getStrings(locale);
const settings = await getSiteSettings();
const siteTitle = settings?.title || SITE.name;
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const metaDescription =
	description || settings?.tagline || `${SITE.name}: ${SITE.tagline}`;

const path = Astro.url.pathname;
const origin = Astro.url.origin;
const canonicalUrl = canonical ?? Astro.url.href;
const idUrl = `${origin}${localizePath(path, "id")}`;
const enUrl = `${origin}${localizePath(path, "en")}`;
const ogLocale = locale === "en" ? "en_US" : "id_ID";
const ogImage = image
	? image.startsWith("http")
		? image
		: `${origin}${image}`
	: undefined;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: metaDescription,
	canonical: canonicalUrl,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});

const beaconToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="id" href={idUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={idUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={ogLocale} />
		{
			ogLocale === "id_ID" ? (
				<meta property="og:locale:alternate" content="en_US" />
			) : (
				<meta property="og:locale:alternate" content="id_ID" />
			)
		}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={metaDescription} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		<meta name="theme-color" content="#016747" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon/favicon-16x16.png" type="image/png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-heading" preload />
		<EmDashHead page={pageCtx} />
		{
			jsonLd && (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			)
		}
		<slot name="jsonld" />
		{
			beaconToken && (
				<script
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: beaconToken })}
				/>
			)
		}
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t.skipToContent}</a>
		<Navbar locale={locale} currentPath={path} />
		<main id="main-content">
			<slot />
		</main>
		<Footer locale={locale} currentPath={path} />

		<script>
			import { initReveals } from "../lib/reveal";
			initReveals();
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Colors use light-dark(); these rules pin the scheme only if
				 * an explicit theme class is ever set. With no class,
				 * color-scheme: light dark follows the OS preference.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: currentColor;
					text-decoration: none;
				}

				/* Inline links in authored content (Portable Text renders bare
				   <a> tags) need a visible style; component links restyle
				   themselves via classes. */
				p a:not([class]),
				li a:not([class]) {
					color: var(--color-brand);
					text-decoration: underline;
					text-underline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				/* Accessibility: visible keyboard focus everywhere */
				:focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
					border-radius: 2px;
				}

				/* Utility classes */
				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-lg);
				}

				.section {
					padding: var(--spacing-5xl) 0;
				}

				.section-header {
					text-align: center;
					max-width: var(--max-width);
					margin: 0 auto var(--spacing-4xl);
				}

				.section-headline {
					font-size: var(--font-size-3xl);
					font-weight: var(--font-weight-display);
				}

				.section-subheadline {
					margin-top: var(--spacing-md);
					font-size: var(--font-size-lg);
					color: var(--color-muted);
				}

				.icon-tile {
					width: 48px;
					height: 48px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					font-size: 1.5rem;
					color: var(--color-on-brand);
					background: var(--gradient-brand);
					border-radius: var(--radius);
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: var(--spacing-sm) var(--spacing-lg);
					font-family: inherit;
					font-size: var(--font-size-sm);
					font-weight: 600;
					border-radius: var(--radius);
					cursor: pointer;
					transition:
						background var(--transition-fast),
						transform var(--transition-fast),
						box-shadow var(--transition-fast);
				}

				.btn:hover {
					transform: translateY(-1px);
				}

				.btn:active {
					transform: translateY(0);
				}

				.btn-primary {
					color: var(--color-on-brand);
					background: var(--gradient-brand-strong);
					border: none;
					transition:
						background 0.3s ease,
						box-shadow 0.3s ease,
						transform var(--transition-fast);
				}

				.btn-primary:hover {
					background: var(--gradient-brand);
					box-shadow: var(--shadow-lg);
				}

				.btn-secondary {
					color: var(--color-text);
					background: transparent;
					border: 1px solid var(--color-border);
				}

				.btn-secondary:hover {
					background: var(--color-surface);
					border-color: var(--color-muted);
				}

				.btn-lg {
					padding: var(--spacing-md) var(--spacing-xl);
					font-size: var(--font-size-base);
				}
			}

			.skip-link {
				position: absolute;
				left: var(--spacing-md);
				top: -100px;
				z-index: 200;
				background: var(--color-brand);
				color: var(--color-on-brand);
				font-size: var(--font-size-sm);
				font-weight: 600;
				padding: var(--spacing-sm) var(--spacing-md);
				border-radius: var(--radius-sm);
				transition: top var(--transition-fast);
			}
			.skip-link:focus {
				top: var(--spacing-md);
			}

			main {
				min-height: calc(100vh - 200px);
			}

			@media (max-width: 768px) {
				h1 {
					font-size: var(--font-size-4xl);
				}
				h2 {
					font-size: var(--font-size-2xl);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</body>
</html>
