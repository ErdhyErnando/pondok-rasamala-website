---
import Base from "./Base.astro";
import PhotoPlaceholder from "../components/ui/PhotoPlaceholder.astro";
import { localizePath, type Locale } from "../lib/i18n";
import { posts, postPath, type PostRow } from "../data/posts";
import { resolvePromos } from "../lib/promo";

// Article: header column (780px) → wide hero (1080px) → narrow reading column
// (66ch, drop cap) with customizable promo cards between paragraphs → related.
// Promos live in data/posts.ts per post; see PromoSchema.
interface Props {
	locale?: Locale;
	post: PostRow;
}

const { locale = "id", post } = Astro.props;
const L = (p: string) => localizePath(p, locale);
const en = locale === "en";
const t = {
	home: en ? "Home" : "Beranda",
	blog: en ? "Blog" : "Blog",
	related: en ? "Related posts" : "Artikel terkait",
	readMore: en ? "Read" : "Baca",
	by: en ? "By" : "Oleh",
};
const promos = resolvePromos(post, locale);
const related = posts.filter((p) => p.slug !== post.slug).slice(0, 2);
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: post.title[locale],
	description: post.excerpt[locale],
	author: { "@type": "Organization", name: post.author },
	datePublished: post.pubDate,
	inLanguage: locale,
};
const pubDate = new Date(post.pubDate + "T00:00:00").toLocaleDateString(
	locale === "en" ? "en-US" : "id-ID",
	{ day: "numeric", month: "long", year: "numeric" },
);
---

<Base
	title={post.title[locale]}
	description={post.excerpt[locale]}
	locale={locale}
	jsonLd={jsonLd}
>
	<div class="container post">
		<div class="post-col">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href={L("/")}>{t.home}</a>
			<span aria-hidden="true">›</span>
			<a href={L("/blog/")}>{t.blog}</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">{post.category[locale]}</span>
		</nav>
		<header class="post-head">
			<p class="eyebrow">{post.category[locale]}</p>
			<h1>{post.title[locale]}</h1>
			<p class="meta">{t.by} {post.author} · {pubDate}</p>
		</header>
		</div>
		<div class="post-hero">
			<PhotoPlaceholder
				label={en ? `${post.title.en}: hero image to follow` : `${post.title.id}: gambar utama menyusul`}
				ratio="16 / 8"
			/>
		</div>
		<div class="prose">
			{post.body[locale].map((para, i) => (
				<>
					<p>{para}</p>
					{promos
						.filter((pr) => pr.after === i + 1)
						.map((pr) => (
							<a class="promo" href={pr.href}>
								<span class="promo-thumb" role="img" aria-label={pr.imageLabel}>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 18 9 11l4 4 3-3 5 6H3Z" /><circle cx="16.5" cy="8.5" r="2" /></svg>
								</span>
								<span class="promo-body">
									<b>{pr.title}</b>
									{pr.body && <span class="promo-text">{pr.body}</span>}
									{pr.meta && <span class="promo-meta">{pr.meta}</span>}
								</span>
								<span class="promo-cta">{pr.cta}</span>
							</a>
						))}
				</>
			))}
		</div>
		<div class="post-col">
		<section class="related">
			<h2>{t.related}</h2>
			<div class="related-grid">
				{related.map((r) => (
					<article class="related-card">
						<p class="card-eyebrow">{r.category[locale]}</p>
						<h3><a href={L(postPath(r.slug))}>{r.title[locale]}</a></h3>
						<p class="card-excerpt">{r.excerpt[locale]}</p>
						<a href={L(postPath(r.slug))} class="card-link">{t.readMore} →</a>
					</article>
				))}
			</div>
		</section>
		</div>
	</div>
</Base>

<style>
	.post {
		max-width: 1080px;
		padding-top: var(--spacing-xl);
		padding-bottom: var(--section-pad);
	}
	/* Header + related stay in a 780px column; hero is wider; prose narrower. */
	.post-col {
		max-width: 780px;
		margin-inline: auto;
	}
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		padding: var(--spacing-md) 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.breadcrumb a:hover {
		color: var(--color-brand);
	}
	.breadcrumb [aria-current="page"] {
		color: var(--color-text);
		font-weight: 600;
	}
	.eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-brand);
	}
	.post-head h1 {
		font-size: clamp(1.9rem, 4vw, 2.9rem);
		letter-spacing: -0.02em;
		line-height: 1.15;
		margin-top: var(--spacing-sm);
		text-wrap: balance;
	}
	.meta {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.post-hero {
		margin-top: var(--spacing-xl);
	}
	.post-hero :global(.photo-placeholder) {
		border-radius: var(--radius-lg);
	}
	.prose {
		max-width: 66ch;
		margin: var(--spacing-2xl) auto 0;
		font-size: 1.125rem;
		line-height: 1.8;
	}
	.prose > * + * {
		margin-top: 1.15em;
	}
	/* Drop cap on the opening paragraph. */
	.prose > p:first-child::first-letter {
		float: left;
		padding: 6px 10px 0 0;
		font-family: var(--font-heading);
		font-size: 3.6em;
		line-height: 0.85;
		color: var(--color-brand);
	}
	/* In-article promo card: thumb · text · button, hairlines above and below. */
	.promo {
		display: grid;
		grid-template-columns: 112px 1fr auto;
		gap: var(--spacing-md);
		align-items: center;
		margin-block: 2em !important;
		padding-block: var(--spacing-md);
		border-block: 1px solid var(--color-border);
		line-height: 1.4;
		text-decoration: none;
		color: inherit;
	}
	.promo-thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1;
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-wood);
		background:
			radial-gradient(120% 100% at 50% 0%, var(--color-brand-soft) 0%, transparent 60%),
			var(--color-surface);
	}
	.promo-thumb svg {
		width: 28px;
		height: 28px;
		opacity: 0.7;
	}
	.promo-body {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}
	.promo-body b {
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 1.2rem;
		line-height: 1.2;
	}
	.promo:hover .promo-body b {
		color: var(--color-brand);
	}
	.promo-text {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.promo-meta {
		font-size: 0.8125rem;
		color: var(--color-wood);
		font-variant-numeric: tabular-nums;
	}
	.promo-cta {
		padding: 8px 16px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		font-size: var(--font-size-sm);
		font-weight: 500;
		white-space: nowrap;
		transition: border-color 0.2s ease;
	}
	.promo:hover .promo-cta {
		border-color: var(--color-text);
	}
	@media (max-width: 560px) {
		.promo {
			grid-template-columns: 80px 1fr;
		}
		.promo-cta {
			grid-column: 1 / -1;
			text-align: center;
		}
	}
	.related {
		margin-top: var(--spacing-3xl);
	}
	.related h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-lg);
	}
	.related-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-xl);
	}
	.related-card {
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.card-eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-brand);
	}
	.related-card h3 {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-lg);
	}
	.related-card h3 a:hover {
		color: var(--color-brand);
	}
	.card-excerpt {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}
	.card-link {
		display: inline-block;
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
	}
	@media (max-width: 700px) {
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
