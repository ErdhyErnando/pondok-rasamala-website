---
import Base from "./Base.astro";
import CTASection from "../components/sections/CTASection.astro";
import DatePicker from "../components/ui/DatePicker.astro";
import PhotoPlaceholder from "../components/ui/PhotoPlaceholder.astro";
import Select from "../components/ui/Select.astro";
import StayCard from "../components/ui/StayCard.astro";
import { stayDetailCta } from "../data/stay-cta";
import { SITE } from "../lib/constants";
import { formatIDR } from "../lib/format";
import type { Locale } from "../lib/i18n";
import type { StayCard as StayCardData, StayPage } from "../lib/stay";

// Shared villa / glamping / aula layout (artifact "lookbook" detail):
// title + tagline → 3-photo gallery → specs & amenities | sticky price card
// → other stays → closing CTA. No breadcrumb, no eyebrow.
// The price card is interactive (tier, date, nights → estimate + WhatsApp
// message) via a small vanilla script; the server-rendered default works
// without JS (WhatsApp link already carries the default message).
interface Props {
	locale?: Locale;
	stay: StayPage;
	related: StayCardData[];
}

const { locale = "id", stay, related } = Astro.props;
const en = locale === "en";
const isAula = stay.segment === "aula";
const cta = stayDetailCta(isAula ? "aula" : stay.kind, stay.name, locale);

const DEFAULT_NIGHTS = 2;
const multi = stay.tiers.length > 1;
const first = stay.tiers[0];

// Message pieces shared by the server default and the client script.
const strings = {
	intro: isAula
		? en
			? "Hello Pondok Rasamala, I'd like to ask about renting the Aula."
			: "Halo Pondok Rasamala, saya ingin menanyakan sewa Aula."
		: en
			? `Hello Pondok Rasamala, I'd like to book ${stay.name}`
			: `Halo Pondok Rasamala, saya ingin pesan ${stay.name}`,
	date: isAula ? (en ? "Date" : "Tanggal") : "Check-in",
	duration: en ? "Duration" : "Durasi",
	night: en ? "night" : "malam",
	nights: en ? "nights" : "malam",
	pending: "...",
	ask: en ? "Is it available? Thank you." : "Apakah tersedia? Terima kasih.",
	locale: en ? "en-GB" : "id-ID",
};
const buildMessage = (tierLabel: string | null, date: string, nights: number) =>
	[
		`${strings.intro}${tierLabel && !isAula ? ` (${tierLabel})` : ""}${isAula ? "" : "."}`,
		`${strings.date}: ${date}`,
		stay.showNights ? `${strings.duration}: ${nights} ${nights === 1 ? strings.night : strings.nights}` : null,
		strings.ask,
	]
		.filter(Boolean)
		.join("\n");
const defaultMessage = buildMessage(multi ? first.label : null, strings.pending, DEFAULT_NIGHTS);
const waBase = `https://wa.me/${SITE.whatsapp}`;
const waHref = `${waBase}?text=${encodeURIComponent(defaultMessage)}`;
const minPrice = Math.min(...stay.tiers.map((t) => t.price));

const L10n = {
	priceTitle: en ? "Rates" : "Harga",
	checkIn: isAula ? (en ? "Date" : "Tanggal") : "Check-in",
	nightsLabel: en ? "Nights" : "Malam",
	messageLabel: en ? "Message we'll send" : "Pesan yang akan dikirim",
	send: en ? "Book via WhatsApp" : "Pesan via WhatsApp",
	askAula: en ? "Ask via WhatsApp" : "Tanya via WhatsApp",
	from: en ? "From" : "Mulai",
	pickTier: en ? "Choose a rate" : "Pilihan harga",
};
const estimateLabel = (n: number) =>
	`${first.priceText} × ${n} ${n === 1 ? strings.night : strings.nights}`;
---

<Base title={stay.name} description={stay.metaDescription} locale={locale}>
	<div class="container detail">
		<header class="d-top">
			<h1>{stay.name}</h1>
			<p class="tagline">{stay.tagline}</p>
		</header>

		<div class="d-gal reveal">
			{stay.gallery.slice(0, 3).map((g) => (
				<PhotoPlaceholder label={g.label} ratio="4 / 3" class="gal-item" />
			))}
		</div>

		<div class="d-body">
			<div class="d-main">
				<p class="d-desc">{stay.description}</p>

				<section class="d-block">
					<h2>{stay.labels.specs}</h2>
					<dl class="specs">
						{stay.specs.map((s) => (
							<div class="spec-row">
								<dt>{s.label}</dt>
								<dd>{s.value}</dd>
							</div>
						))}
					</dl>
				</section>

				{stay.amenities.length > 0 && (
					<section class="d-block">
						<h2>{en ? "Facilities" : "Fasilitas"}</h2>
						<ul class="checks">
							{stay.amenities.map((a) => (
								<li>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
									<span>{a}</span>
								</li>
							))}
						</ul>
					</section>
				)}
			</div>

			<aside class="d-aside">
				<div
					class="pcard"
					data-pcard
					data-wa-base={waBase}
					data-show-nights={stay.showNights ? "true" : "false"}
					data-multi={multi ? "true" : "false"}
					data-strings={JSON.stringify(strings)}
					data-tiers={JSON.stringify(stay.tiers)}
				>
					<h2>{L10n.priceTitle}</h2>
					<div class="tiers" role={multi ? "radiogroup" : undefined} aria-label={multi ? L10n.pickTier : undefined}>
						{stay.tiers.map((t, i) =>
							multi ? (
								<label class="tier">
									<input type="radio" name="tier" value={i} checked={i === 0} />
									<span>{t.label}</span>
									<strong>{t.priceText}</strong>
								</label>
							) : (
								<div class="tier single">
									<span>{t.label}</span>
									<strong>{t.priceText}</strong>
								</div>
							),
						)}
					</div>

					<div class="fields">
						<div class="field">
							<span class="field-label" aria-hidden="true">{L10n.checkIn}</span>
							<DatePicker id="stay-date" locale={locale} label={L10n.checkIn} inputAttrs={{ "data-date": true }} />
						</div>
						{stay.showNights && (
							<div class="field">
								<span class="field-label" aria-hidden="true">{L10n.nightsLabel}</span>
								<Select
									id="stay-nights"
									label={L10n.nightsLabel}
									value={String(DEFAULT_NIGHTS)}
									options={[1, 2, 3, 4, 5, 6, 7].map((n) => ({ value: String(n), label: String(n) }))}
									inputAttrs={{ "data-nights": true }}
								/>
							</div>
						)}
					</div>

					{stay.showNights && (
						<div class="est" aria-live="polite">
							<span data-est-label>{estimateLabel(DEFAULT_NIGHTS)}</span>
							<strong data-est-total>{formatIDR(first.price * DEFAULT_NIGHTS)}</strong>
						</div>
					)}

					<p class="msg-label">{L10n.messageLabel}</p>
					<p class="msg" data-msg>{defaultMessage}</p>
					<a class="send" href={waHref} target="_blank" rel="noopener" data-send>
						{stay.showNights ? L10n.send : L10n.askAula}
					</a>
					<p class="p-note">{stay.priceNote}</p>
				</div>
			</aside>
		</div>

		<section class="related" data-related>
			<h2>{stay.labels.related}</h2>
			<div class="stay-grid">
				{related.map((c) => (
					<StayCard href={c.href} name={c.name} blurb={c.blurb} imageLabel={c.imageLabel} facts={c.facts} />
				))}
			</div>
		</section>
	</div>

	<CTASection locale={locale} title={cta.title} body={cta.body} message={cta.message} />

	<div class="mbar" data-mbar aria-hidden="true">
		<div>
			<strong>{multi ? `${L10n.from} ${formatIDR(minPrice)}` : first.priceText}</strong>
			<span>{stay.name}</span>
		</div>
		<a class="send" href={waHref} target="_blank" rel="noopener" data-send tabindex="-1">
			{stay.showNights ? L10n.send : L10n.askAula}
		</a>
	</div>
</Base>

<script>
	interface Tier {
		label: string;
		price: number;
		priceText: string;
	}
	interface Strings {
		intro: string;
		date: string;
		duration: string;
		night: string;
		nights: string;
		pending: string;
		ask: string;
		locale: string;
	}

	const card = document.querySelector<HTMLElement>("[data-pcard]");
	if (card) {
		const tiers = JSON.parse(card.dataset.tiers ?? "[]") as Tier[];
		const s = JSON.parse(card.dataset.strings ?? "{}") as Strings;
		const base = card.dataset.waBase ?? "";
		const showNights = card.dataset.showNights === "true";
		const multi = card.dataset.multi === "true";
		const isAula = !showNights;

		const date = card.querySelector<HTMLInputElement>("[data-date]");
		const nightsEl = card.querySelector<HTMLInputElement>("[data-nights]");
		const estLabel = card.querySelector<HTMLElement>("[data-est-label]");
		const estTotal = card.querySelector<HTMLElement>("[data-est-total]");
		const msgEl = card.querySelector<HTMLElement>("[data-msg]");
		const sends = document.querySelectorAll<HTMLAnchorElement>("[data-send]");
		const idr = (n: number) => `Rp${n.toLocaleString("id-ID")}`;

		const fmtDate = (v: string) => {
			if (!v) return s.pending;
			const [y, m, d] = v.split("-").map(Number);
			return new Date(y, m - 1, d).toLocaleDateString(s.locale, {
				day: "numeric",
				month: "long",
				year: "numeric",
			});
		};

		const update = () => {
			const checked = card.querySelector<HTMLInputElement>('input[name="tier"]:checked');
			const tier = tiers[checked ? Number(checked.value) : 0];
			const n = nightsEl ? Number(nightsEl.value) : 1;
			const word = n === 1 ? s.night : s.nights;
			const lines = [
				`${s.intro}${multi && !isAula ? ` (${tier.label})` : ""}${isAula ? "" : "."}`,
				`${s.date}: ${fmtDate(date?.value ?? "")}`,
				showNights ? `${s.duration}: ${n} ${word}` : null,
				s.ask,
			].filter(Boolean) as string[];
			const message = lines.join("\n");

			if (estLabel) estLabel.textContent = `${tier.priceText} × ${n} ${word}`;
			if (estTotal) estTotal.textContent = idr(tier.price * n);
			if (msgEl) msgEl.textContent = message;
			sends.forEach((a) => (a.href = `${base}?text=${encodeURIComponent(message)}`));
		};

		card.addEventListener("input", update);
		card.addEventListener("change", update);
		update();
	}

	// Mobile bar: shown while the price card is off-screen and the page
	// hasn't reached "other stays" / the closing CTA yet.
	const bar = document.querySelector<HTMLElement>("[data-mbar]");
	const priceCard = document.querySelector<HTMLElement>("[data-pcard]");
	const related = document.querySelector<HTMLElement>("[data-related]");
	if (bar && priceCard && related && "IntersectionObserver" in window) {
		let cardVisible = false;
		let pastRelated = false;
		const sync = () => {
			const show = !cardVisible && !pastRelated;
			bar.classList.toggle("show", show);
			bar.toggleAttribute("inert", !show);
			bar.setAttribute("aria-hidden", String(!show));
		};
		new IntersectionObserver((e) => {
			cardVisible = e[0].isIntersecting;
			sync();
		}).observe(priceCard);
		new IntersectionObserver(
			(e) => {
				pastRelated = e[0].isIntersecting || e[0].boundingClientRect.top < 0;
				sync();
			},
			{ rootMargin: "0px 0px -20% 0px" },
		).observe(related);
		sync();
	}
</script>

<style>
	.detail {
		padding-top: clamp(2.25rem, 5vw, 4rem);
		padding-bottom: var(--section-pad);
	}
	.d-top {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-xl);
		max-width: 56rem;
	}
	.d-top h1 {
		font-size: clamp(2.1rem, 1.5rem + 2.3vw, 3.5rem);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		line-height: 1.1;
		text-wrap: balance;
	}
	.tagline {
		font-family: var(--font-heading);
		font-style: italic;
		font-size: clamp(1.2rem, 1.08rem + 0.5vw, 1.5rem);
		color: var(--color-muted);
	}

	/* Gallery: one large photo + two stacked (artifact lookbook) */
	.d-gal {
		display: grid;
		grid-template-columns: 2fr 1fr;
		grid-template-rows: repeat(2, clamp(150px, 18vw, 250px));
		gap: 12px;
	}
	.d-gal :global(.gal-item) {
		aspect-ratio: auto !important;
		height: 100%;
		border-radius: var(--radius);
	}
	.d-gal :global(.gal-item:first-child) {
		grid-row: 1 / span 2;
		border-radius: var(--radius-lg);
	}
	@media (max-width: 700px) {
		.d-gal {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: clamp(220px, 60vw, 340px) 110px;
		}
		.d-gal :global(.gal-item:first-child) {
			grid-column: 1 / -1;
			grid-row: auto;
		}
	}

	.d-body {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: var(--spacing-2xl) var(--spacing-xl);
		margin-top: var(--spacing-3xl);
	}
	.d-main {
		grid-column: 1 / span 7;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
		min-width: 0;
	}
	.d-aside {
		grid-column: 9 / span 4;
		position: sticky;
		top: 7rem;
		align-self: start;
	}
	@media (max-width: 960px) {
		.d-main,
		.d-aside {
			grid-column: 1 / -1;
		}
		.d-aside {
			position: static;
		}
	}
	.d-desc {
		font-size: var(--font-size-lg);
		line-height: 1.7;
		color: var(--color-muted);
		max-width: 66ch;
	}
	.d-block {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}
	.d-block h2 {
		font-size: var(--font-size-xl);
		letter-spacing: var(--tracking-snug);
	}
	.specs {
		border-top: 1px solid var(--color-text);
	}
	.spec-row {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--spacing-md);
		padding: 13px 0;
		border-bottom: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
	}
	.spec-row dt {
		color: var(--color-muted);
	}
	.spec-row dd {
		margin: 0;
	}
	@media (max-width: 520px) {
		.spec-row {
			grid-template-columns: 1fr;
			gap: 2px;
		}
	}
	.checks {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 var(--spacing-xl);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.checks li {
		display: flex;
		gap: 10px;
		padding: 9px 0;
		border-bottom: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
	}
	.checks svg {
		width: 18px;
		height: 18px;
		flex: none;
		margin-top: 2px;
		color: var(--color-brand);
	}
	@media (max-width: 520px) {
		.checks {
			grid-template-columns: 1fr;
		}
	}

	/* Price card */
	.pcard {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
	}
	.pcard h2 {
		font-size: var(--font-size-lg);
	}
	.tiers {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.tier {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-sm);
		padding: 12px 14px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}
	.tier.single {
		cursor: default;
		border-color: var(--color-brand);
		background: var(--color-brand-soft);
	}
	.tier input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.tier:has(input:checked) {
		border-color: var(--color-brand);
		background: var(--color-brand-soft);
	}
	.tier:has(input:focus-visible) {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}
	.tier strong {
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 1.15rem;
		white-space: nowrap;
	}
	.fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}
	.fields:has(.field:only-child) {
		grid-template-columns: 1fr;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}
	.field-label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}
	.est {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-sm);
		padding-top: var(--spacing-sm);
		border-top: 1px dashed var(--color-border);
		font-size: var(--font-size-sm);
		font-variant-numeric: tabular-nums;
	}
	.est strong {
		font-weight: 700;
	}
	.msg-label {
		font-size: 0.75rem;
		color: var(--color-muted);
	}
	.msg {
		padding: 10px 12px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-muted);
		white-space: pre-line;
		margin-top: calc(var(--spacing-md) * -0.5);
	}
	.send {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 54px;
		padding: 0 26px;
		border-radius: var(--radius-full);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition:
			transform 0.16s ease,
			background-color 0.2s ease;
	}
	.send:hover {
		background: var(--color-brand-strong);
		color: var(--color-on-brand);
	}
	.send:active {
		transform: scale(0.97);
	}
	.p-note {
		font-size: 0.78rem;
		color: var(--color-muted);
		text-align: center;
	}

	/* Other stays */
	.related {
		margin-top: var(--section-pad);
		padding-top: var(--spacing-xl);
		border-top: 1px solid var(--color-border);
	}
	.related h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-xl);
	}
	.stay-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-2xl) var(--spacing-xl);
	}
	@media (max-width: 960px) {
		.stay-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.stay-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Mobile sticky booking bar */
	.mbar {
		position: fixed;
		inset: auto 0 0;
		z-index: 40;
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 12px max(16px, env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom))
			max(16px, env(safe-area-inset-left));
		background: color-mix(in srgb, var(--color-bg) 96%, transparent);
		border-top: 1px solid var(--color-border);
		transform: translateY(100%);
		transition: transform 0.24s cubic-bezier(0.23, 1, 0.32, 1);
	}
	.mbar.show {
		transform: none;
	}
	.mbar strong {
		display: block;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 1.1rem;
	}
	.mbar span {
		font-size: 0.78rem;
		color: var(--color-muted);
	}
	.mbar .send {
		height: 44px;
		padding: 0 18px;
	}
	@media (max-width: 960px) {
		.mbar {
			display: flex;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.mbar,
		.send {
			transition: none;
		}
	}
</style>
