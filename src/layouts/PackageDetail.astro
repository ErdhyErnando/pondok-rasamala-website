---
import Base from "./Base.astro";
import Lightbox from "../components/ui/Lightbox.astro";
import PackageCard from "../components/ui/PackageCard.astro";
import Photo from "../components/ui/Photo.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import { formatIDR } from "../lib/format";
import { packageCardProps } from "../lib/packages";
import { getStrings, localizePath, type Locale } from "../lib/i18n";
import { packages, type PackageRow } from "../data/packages";

// Shared package detail wrapper: hero → includes + tiers + activities → CTA.
interface Props {
	locale?: Locale;
	pkg: PackageRow;
}

const { locale = "id", pkg } = Astro.props;
const L = (p: string) => localizePath(p, locale);
const en = locale === "en";
const t = {
	home: en ? "Home" : "Beranda",
	allPackages: en ? "All Packages" : "Semua Paket",
	includes: en ? "What's included" : "Termasuk dalam paket",
	tiers: en ? "Options & pricing" : "Pilihan & harga",
	activities: en ? "Activities" : "Aktivitas",
	gallery: en ? "Gallery" : "Galeri",
	close: en ? "Close" : "Tutup",
	other: en ? "Other packages" : "Paket lainnya",
	verifyNote: en ? "Web anchor, confirmed via WhatsApp" : "Acuan web, konfirmasi via WhatsApp",
	quoteCta: en ? "Request a quote" : "Minta penawaran",
	perEvent: (u: string) => u,
};
const waMessage = en
	? `Hello Pondok Rasamala, I'd like to ask about the ${pkg.name.en} package. Thank you.`
	: `Halo Pondok Rasamala, saya mau bertanya tentang ${pkg.name.id}. Terima kasih.`;
const others = packages.filter((p) => p.slug !== pkg.slug);
const ui = getStrings(locale).actions;
// Hero first; the strip below starts at the second photo and the lightbox holds all of them.
const items = [pkg.hero, ...pkg.gallery].map((p) => ({ label: p.alt[locale], photo: p }));
// Hero: 1200 px container with 24 px padding. Strip: inside .pkg-main (max 44rem), 3 columns
// with 16 px gaps; 2 columns under 601 px. Related cards sit in a 3-column grid (1 column under 901 px).
const heroSizes = "(min-width: 1200px) 1152px, calc(100vw - 48px)";
const stripSizes = "(min-width: 1200px) 224px, (min-width: 901px) calc((100vw - 48px) * 1.6 / 2.6 / 3 - 24px), (min-width: 601px) calc((100vw - 80px) / 3), calc((100vw - 64px) / 2)";
const relatedSizes = "(min-width: 1200px) 154px, (min-width: 901px) calc(((100vw - 112px) / 3 - 24px) * 5 / 11), (min-width: 481px) calc((min(560px, 100vw - 48px) - 24px) * 5 / 11), min(560px, calc(100vw - 48px))";
---

<Base title={pkg.name[locale]} description={pkg.tagline[locale]} locale={locale}>
	<div class="container">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href={L("/")}>{t.home}</a>
			<span aria-hidden="true">›</span>
			<a href={L("/package/")}>{t.allPackages}</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">{pkg.name[locale]}</span>
		</nav>

		<div class="pkg-hero">
			<button type="button" class="hero-open" data-lightbox-open="0" aria-haspopup="dialog">
				<Photo
					photo={pkg.hero}
					locale={locale}
					sizes={heroSizes}
					widths={[960, 1600, 2400]}
					loading="eager"
					fetchpriority="high"
					ratio="16 / 8"
					class="hero-img"
				/>
			</button>
		</div>

		<div class="pkg-grid">
			<div class="pkg-main">
				<h1>{pkg.name[locale]}</h1>
				<p class="tagline">{pkg.tagline[locale]}</p>
				<p class="description">{pkg.description[locale]}</p>

				<h2>{t.includes}</h2>
				<ul class="check-list">
					{pkg.includes[locale].map((item) => <li>{item}</li>)}
				</ul>

				<h2>{t.activities}</h2>
				<ul class="pill-list">
					{pkg.activities[locale].map((item) => <li>{item}</li>)}
				</ul>

				{pkg.gallery.length > 0 && (
					<>
						<h2>{t.gallery}</h2>
						<Lightbox
							items={items}
							locale={locale}
							stripFrom={1}
							stripSizes={stripSizes}
							closeLabel={t.close}
							prevLabel={ui.previousPhoto}
							nextLabel={ui.nextPhoto}
						/>
					</>
				)}
			</div>

			<aside class="pkg-sidebar">
				<div class="price-card">
					<h2>{t.tiers}</h2>
					<ul>
						{pkg.tiers.map((tier) => (
							<li>
								<span>{tier.name[locale]}</span>
								{tier.price != null ? (
									<strong>
										{formatIDR(tier.price)}
										<em>{tier.unit[locale]}</em>
										{tier.verify && <span class="verify">*</span>}
									</strong>
								) : (
									<strong class="on-request">{t.quoteCta}</strong>
								)}
							</li>
						))}
					</ul>
					{pkg.tiers.some((tier) => tier.verify) && (
						<p class="price-note">* {t.verifyNote}</p>
					)}
					<WhatsAppButton message={waMessage} locale={locale} size="lg" class="sidebar-cta" />
				</div>
			</aside>
		</div>

		<section class="related">
			<h2>{t.other}</h2>
			<div class="related-grid">
				{others.map((o) => (
					<PackageCard {...packageCardProps(o, locale)} sizes={relatedSizes} />
				))}
			</div>
		</section>
	</div>
</Base>

<script>
	// The hero opens the lightbox at the first photo (the Lightbox listens on its strip).
	document.querySelectorAll<HTMLElement>("[data-lightbox-open]").forEach((btn) => {
		btn.addEventListener("click", () => {
			document
				.querySelector("[data-strip]")
				?.dispatchEvent(new CustomEvent("lightbox-open", { detail: Number(btn.dataset.lightboxOpen) }));
		});
	});
</script>

<style>
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		padding: var(--spacing-xl) 0 var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.breadcrumb a:hover {
		color: var(--color-brand);
	}
	.breadcrumb [aria-current="page"] {
		color: var(--color-text);
		font-weight: 600;
	}
	.hero-open {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		cursor: zoom-in;
	}
	.pkg-hero :global(img.hero-img) {
		border-radius: var(--radius-lg);
	}
	@media (max-width: 600px) {
		/* The inline 16 / 8 would leave a thin strip on a phone. */
		.pkg-hero :global(img.hero-img) {
			aspect-ratio: 4 / 3 !important;
		}
	}
	.pkg-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: var(--spacing-3xl);
		margin-top: var(--spacing-3xl);
		align-items: start;
	}
	.pkg-main {
		max-width: 44rem;
	}
	.pkg-main h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-top: var(--spacing-sm);
		text-wrap: balance;
	}
	.tagline {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}
	.description {
		margin-top: var(--spacing-lg);
		line-height: var(--leading-relaxed);
	}
	.pkg-main h2 {
		margin-top: var(--spacing-3xl);
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-xl);
		letter-spacing: var(--tracking-snug);
	}
	.check-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}
	.check-list li {
		display: flex;
		gap: var(--spacing-sm);
		align-items: baseline;
	}
	.check-list li::before {
		content: "✓";
		color: var(--color-brand);
		font-weight: 700;
	}
	.pill-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}
	.pill-list li {
		padding: 0.375rem 0.875rem;
		font-size: var(--font-size-sm);
		font-weight: 600;
		background: var(--color-brand-soft);
		color: var(--color-brand);
		border-radius: var(--radius-full);
	}
	/* Stretch to the row height (the grid aligns items to the start), so the
	   sticky card has room to travel while the long left column scrolls. */
	.pkg-sidebar {
		align-self: stretch;
	}
	.price-card {
		position: sticky;
		top: 96px;
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.price-card h2 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-md);
	}
	.price-card ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}
	.price-card li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--spacing-md);
		font-size: var(--font-size-sm);
	}
	.price-card li strong {
		font-size: var(--font-size-lg);
		letter-spacing: var(--tracking-snug);
		white-space: nowrap;
		text-align: right;
	}
	.price-card li em {
		display: block;
		font-style: normal;
		font-weight: 500;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}
	.verify {
		color: var(--color-brand);
	}
	.on-request {
		font-size: var(--font-size-base) !important;
		color: var(--color-brand);
	}
	.price-note {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}
	.price-card :global(.sidebar-cta) {
		width: 100%;
		margin-top: var(--spacing-md);
	}
	.related {
		padding: var(--section-pad) 0;
	}
	.related h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-xl);
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-xl);
	}
	@media (max-width: 900px) {
		.pkg-grid {
			grid-template-columns: 1fr;
		}
		.price-card {
			position: static;
		}
		.related-grid {
			grid-template-columns: 1fr;
			max-width: 560px;
		}
	}
</style>
