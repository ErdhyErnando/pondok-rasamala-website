---
import { getStrings, localizePath, type Locale } from "../../lib/i18n";

// ID/EN switch. Links the same path across locale trees (no client state).
// `dropdown` (default) is the compact header control: a pill showing only the
// active locale, so it costs ~38px instead of the old ID / EN pair and leaves
// room for the theme toggle. `inline` keeps the two-link form for the footer.
// Native <details> gives open/close, focus order, and Esc-free keyboard use
// without JS; the script only adds click-outside and Escape.
interface Props {
	locale?: Locale;
	path?: string;
	class?: string;
	variant?: "dropdown" | "inline";
}

const {
	locale = "id",
	path = "/",
	class: className = "",
	variant = "dropdown",
} = Astro.props;
const t = getStrings(locale);
const idHref = localizePath(path, "id");
const enHref = localizePath(path, "en");
const options = [
	{ code: "ID", href: idHref, active: locale === "id" },
	{ code: "EN", href: enHref, active: locale === "en" },
];
---

{
	variant === "inline" ? (
		<nav class:list={["lang-toggle", className]} aria-label={t.footer.language}>
			<a
				href={idHref}
				aria-current={locale === "id" ? "true" : undefined}
				class:list={[{ active: locale === "id" }]}>ID</a
			>
			<span aria-hidden="true">/</span>
			<a
				href={enHref}
				aria-current={locale === "en" ? "true" : undefined}
				class:list={[{ active: locale === "en" }]}>EN</a
			>
		</nav>
	) : (
		<details class:list={["lang-menu", className]}>
			<summary aria-label={t.actions.chooseLanguage}>
				<span class="lang-current">{locale.toUpperCase()}</span>
				<svg class="chevron" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
					<path fill="currentColor" d="M2.4 1.1 3.7 1.1 7.8 5 3.7 8.9 2.4 8.9 6.2 5Z" />
				</svg>
			</summary>
			<ul class="lang-options">
				{options.map((o) => (
					<li>
						<a href={o.href} aria-current={o.active ? "page" : undefined} class:list={[{ active: o.active }]}>
							{o.code}
						</a>
					</li>
				))}
			</ul>
		</details>
	)
}

<script>
	// Click-outside + Escape. <summary> handles its own open/close.
	document.querySelectorAll<HTMLDetailsElement>("details.lang-menu").forEach((menu) => {
		if (menu.dataset.wired) return;
		menu.dataset.wired = "true";
		const summary = menu.querySelector("summary");

		document.addEventListener("click", (e) => {
			if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && menu.open) {
				menu.open = false;
				summary?.focus();
			}
		});
	});
</script>

<style>
	/* --- inline (footer) ---------------------------------------------- */
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: var(--font-size-sm);
		font-weight: 600;
	}
	.lang-toggle span {
		opacity: 0.4;
	}
	.lang-toggle a {
		opacity: 0.55;
		padding: 0.25rem 0.125rem;
	}
	.lang-toggle a:hover {
		opacity: 1;
	}
	.lang-toggle a.active {
		opacity: 1;
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* The footer band is deep forest, where the brand green would drop to
	   1.4:1. The parent passes this class, so the rule can live here, a
	   scoped `.site-footer …` selector in Footer.astro would never match
	   this component's root element. */
	.footer-lang a.active {
		color: inherit;
	}

	/* --- dropdown ------------------------------------------------------ */
	.lang-menu {
		position: relative;
	}
	.lang-menu > summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		height: 38px;
		padding: 0 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-muted);
		cursor: pointer;
		list-style: none;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.lang-menu > summary::-webkit-details-marker {
		display: none;
	}
	.lang-menu > summary:hover,
	.lang-menu[open] > summary {
		color: var(--color-text);
		border-color: var(--color-muted);
	}
	.chevron {
		width: 0.55em;
		height: 0.55em;
		flex-shrink: 0;
		transition: transform 0.25s ease;
	}
	.lang-menu[open] .chevron {
		transform: rotate(90deg);
	}
	.lang-options {
		position: absolute;
		top: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		z-index: 30;
		min-width: 100%;
		margin: 0;
		padding: 0.25rem;
		list-style: none;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-lg);
	}
	.lang-options a {
		display: block;
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-align: center;
		text-decoration: none;
		color: var(--color-text);
		white-space: nowrap;
	}
	.lang-options a:hover {
		background: var(--color-brand-soft);
		color: var(--color-text);
	}
	.lang-options a.active {
		color: var(--color-brand);
	}
	@media (prefers-reduced-motion: reduce) {
		.chevron,
		.lang-menu > summary {
			transition: none;
		}
	}
</style>
