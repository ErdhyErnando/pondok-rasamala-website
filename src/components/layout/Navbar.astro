---
import { glamping, glampingPath } from "../../data/glamping";
import { villas, villaPath } from "../../data/villas";
import { getStrings, localizePath, type Locale } from "../../lib/i18n";
import { waGeneral } from "../../lib/whatsapp";
import LanguageToggle from "./LanguageToggle.astro";

// Calm sticky header: transparent over hero → frosted paper on scroll.
// Dropdowns are data-driven (villas.ts / glamping.ts); packages are the
// four Day-4 slugs so the chrome is stable before packages.ts lands.
interface Props {
	locale?: Locale;
	currentPath?: string;
}

const { locale = "id", currentPath = Astro.url.pathname } = Astro.props;
const t = getStrings(locale);
const L = (p: string) => localizePath(p, locale);
const isActive = (p: string) => currentPath === L(p);

const stayLinks = villas.map((v) => ({ href: L(villaPath(v.slug)), label: v.name }));
const glampingLinks = glamping.map((g) => ({
	href: L(glampingPath(g.slug)),
	label: `Glamping ${g.name}`,
}));
const packageLinks = [
	{ slug: "outbound", label: t.nav.packageOutbound },
	{ slug: "special-school-package", label: t.nav.packageSchool },
	{ slug: "company-outing", label: t.nav.packageCompany },
	{ slug: "family", label: t.nav.packageFamily },
].map((p) => ({ href: L(`/package/${p.slug}/`), label: p.label }));
---

<header class="site-header" id="site-header">
	<nav class="nav" aria-label={t.nav.mainMenu}>
		<a href={L("/")} class="brand" aria-label="Pondok Rasamala">
			<img
				src="/brand/rasamala-badge.png"
				alt=""
				width="40"
				height="40"
				class="brand-badge"
			/>
			<span class="wordmark">Pondok Rasamala</span>
		</a>

		<ul class="nav-links">
			<li><a href={L("/")} class:list={[{ active: isActive("/") }]}>{t.nav.home}</a></li>
			<li class="optional">
				<a href={L("/about-us/")} class:list={[{ active: isActive("/about-us/") }]}>
					{t.nav.about}
				</a>
			</li>
			<li class="optional">
				<a href={L("/location/")} class:list={[{ active: isActive("/location/") }]}>
					{t.nav.location}
				</a>
			</li>
			<li class="has-dropdown">
				<a
					href={L("/villa/")}
					aria-haspopup="true"
					class:list={[{ active: currentPath.includes("/type-") || isActive("/villa/") }]}
				>
					{t.nav.villa}
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
				</a>
				<div class="dropdown">
					<a href={L("/villa/")} class="dropdown-all">{t.nav.allVillas}</a>
					{stayLinks.map((l) => <a href={l.href}>{l.label}</a>)}
				</div>
			</li>
			<li class="has-dropdown">
				<a
					href={L("/glamping/")}
					aria-haspopup="true"
					class:list={[{ active: currentPath.includes("/glamping-type-") || isActive("/glamping/") }]}
				>
					{t.nav.glamping}
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
				</a>
				<div class="dropdown">
					<a href={L("/glamping/")} class="dropdown-all">{t.nav.allGlamping}</a>
					{glampingLinks.map((l) => <a href={l.href}>{l.label}</a>)}
				</div>
			</li>
			<li>
				<a href={L("/campsite/")} class:list={[{ active: isActive("/campsite/") }]}>
					{t.nav.campsite}
				</a>
			</li>
			<li class="has-dropdown">
				<a
					href={L("/package/")}
					aria-haspopup="true"
					class:list={[{ active: currentPath.includes("/package") }]}
				>
					{t.nav.packages}
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
				</a>
				<div class="dropdown">
					<a href={L("/package/")} class="dropdown-all">{t.nav.allPackages}</a>
					{packageLinks.map((l) => <a href={l.href}>{l.label}</a>)}
				</div>
			</li>
			<li class="optional">
				<a href={L("/attractions/")} class:list={[{ active: isActive("/attractions/") }]}>
					{t.nav.attractions}
				</a>
			</li>
			<li><a href={L("/gallery/")} class:list={[{ active: isActive("/gallery/") }]}>{t.nav.gallery}</a></li>
			<li><a href={L("/blog/")} class:list={[{ active: isActive("/blog/") }]}>{t.nav.blog}</a></li>
			<li>
				<a href={L("/contact-us/")} class:list={[{ active: isActive("/contact-us/") }]}>
					{t.nav.contact}
				</a>
			</li>
		</ul>

		<div class="nav-actions">
			<LanguageToggle locale={locale} path={currentPath} class="nav-lang" />
			<a href={waGeneral()} target="_blank" rel="noopener" class="btn btn-whatsapp nav-cta">
				{t.actions.bookNow}
			</a>
			<button
				type="button"
				class="nav-toggle"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label={t.actions.openMenu}
			>
				<svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
				<svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
			</button>
		</div>
	</nav>

	<div class="mobile-nav" id="mobile-nav" hidden>
		<div class="mobile-nav-inner">
			<p class="mobile-group">{t.footer.stay}</p>
			<a href={L("/villa/")}>{t.nav.allVillas}</a>
			<a href={L("/glamping/")}>{t.nav.allGlamping}</a>
			<a href={L("/campsite/")}>{t.nav.campsite}</a>
			<p class="mobile-group">{t.nav.packages}</p>
			<a href={L("/package/")}>{t.nav.allPackages}</a>
			{packageLinks.map((l) => <a href={l.href}>{l.label}</a>)}
			<p class="mobile-group">{t.footer.explore}</p>
			<a href={L("/about-us/")}>{t.nav.about}</a>
			<a href={L("/location/")}>{t.nav.location}</a>
			<a href={L("/attractions/")}>{t.nav.attractions}</a>
			<a href={L("/gallery/")}>{t.nav.gallery}</a>
			<a href={L("/blog/")}>{t.nav.blog}</a>
			<a href={L("/contact-us/")}>{t.nav.contact}</a>
			<div class="mobile-cta">
				<a href={waGeneral()} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
					{t.actions.bookNow}
				</a>
				<LanguageToggle locale={locale} path={currentPath} />
			</div>
		</div>
	</div>
</header>

<script>
	// Frosted-on-scroll header + vanilla full-screen mobile nav. No framework.
	const header = document.getElementById("site-header");
	const toggle = header?.querySelector(".nav-toggle");
	const mobileNav = document.getElementById("mobile-nav");

	const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
	onScroll();
	window.addEventListener("scroll", onScroll, { passive: true });

	function setMenu(open: boolean) {
		if (!toggle || !mobileNav) return;
		toggle.setAttribute("aria-expanded", String(open));
		toggle.classList.toggle("is-open", open);
		if (open) {
			mobileNav.hidden = false;
			requestAnimationFrame(() => mobileNav.classList.add("open"));
			document.body.classList.add("menu-open");
		} else {
			mobileNav.classList.remove("open");
			document.body.classList.remove("menu-open");
			window.setTimeout(() => {
				if (!mobileNav.classList.contains("open")) mobileNav.hidden = true;
			}, 200);
		}
	}

	toggle?.addEventListener("click", () =>
		setMenu(toggle.getAttribute("aria-expanded") !== "true"),
	);
	mobileNav?.addEventListener("click", (e) => {
		if ((e.target as HTMLElement).closest("a")) setMenu(false);
	});
	window.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setMenu(false);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: transparent;
		transition:
			background var(--transition-base),
			border-color var(--transition-base),
			backdrop-filter var(--transition-base);
		border-bottom: 1px solid transparent;
	}
	.site-header.is-scrolled {
		background: color-mix(in srgb, var(--color-bg) 88%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom-color: var(--color-border);
	}

	.nav {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-md) var(--spacing-lg);
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		flex-shrink: 0;
	}
	.brand-badge {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}
	.wordmark {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		white-space: nowrap;
	}

	.nav-links {
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: var(--spacing-md);
		margin-left: auto;
		list-style: none;
	}
	.nav-links > li > a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-muted);
		padding: 0.375rem 0.125rem;
		white-space: nowrap;
		border-bottom: 2px solid transparent;
	}
	.nav-links > li > a:hover {
		color: var(--color-text);
	}
	.nav-links > li > a.active {
		color: var(--color-text);
		border-bottom-color: var(--color-brand);
	}
	.nav-links svg {
		width: 0.85em;
		height: 0.85em;
	}

	.has-dropdown {
		position: relative;
	}
	.dropdown {
		position: absolute;
		top: calc(100% + 8px);
		left: 50%;
		transform: translate(-50%, 4px);
		min-width: 220px;
		max-height: min(70vh, 480px);
		overflow: auto;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-lg);
		padding: var(--spacing-sm);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--transition-fast),
			transform var(--transition-fast),
			visibility var(--transition-fast);
	}
	.has-dropdown:hover .dropdown,
	.has-dropdown:focus-within .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
	}
	.dropdown a {
		display: block;
		font-size: var(--font-size-sm);
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-sm);
		color: var(--color-text);
		white-space: nowrap;
	}
	.dropdown a:hover {
		background: var(--color-surface);
	}
	.dropdown-all {
		font-weight: 700 !important;
		color: var(--color-brand) !important;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0 !important;
		margin-bottom: var(--spacing-xs);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		flex-shrink: 0;
	}
	.nav-cta {
		padding: var(--spacing-sm) var(--spacing-md);
		border-radius: var(--radius-full);
		font-size: var(--font-size-sm);
		white-space: nowrap;
	}

	.nav-toggle {
		display: none;
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text);
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.nav-toggle svg {
		width: 22px;
		height: 22px;
	}
	.nav-toggle .icon-close {
		display: none;
	}
	.nav-toggle.is-open .icon-open {
		display: none;
	}
	.nav-toggle.is-open .icon-close {
		display: block;
	}

	.mobile-nav {
		position: fixed;
		inset: 0;
		top: 0;
		background: var(--color-bg);
		z-index: 99;
		overflow: auto;
		padding: 5.5rem var(--spacing-lg) var(--spacing-2xl);
		opacity: 0;
		transition: opacity 200ms ease;
	}
	.mobile-nav.open {
		opacity: 1;
	}
	.mobile-nav-inner {
		display: flex;
		flex-direction: column;
		max-width: 560px;
		margin: 0 auto;
	}
	.mobile-nav-inner > a {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--color-border);
	}
	.mobile-group {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-brand);
		margin: var(--spacing-lg) 0 var(--spacing-xs);
	}
	.mobile-cta {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--spacing-md);
		margin-top: var(--spacing-xl);
		text-align: center;
	}
	.mobile-cta .lang-toggle {
		justify-content: center;
	}
	:global(body.menu-open) {
		overflow: hidden;
	}

	@media (max-width: 1180px) {
		.nav-links .optional {
			display: none;
		}
	}
	@media (max-width: 960px) {
		.nav-links,
		.nav-lang {
			display: none;
		}
		.nav-toggle {
			display: inline-flex;
		}
		.nav {
			justify-content: space-between;
		}
		.nav-actions {
			margin-left: auto;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.dropdown,
		.mobile-nav {
			transition: none;
		}
	}
</style>
