---
import { getStrings, localizePath, type Locale } from "../../lib/i18n";
import { SITE } from "../../lib/constants";
import { waGeneral } from "../../lib/whatsapp";
import LanguageToggle from "./LanguageToggle.astro";

// Cyze-style closing panel: inset rounded gradient, centered link
// rows with solid light type, socials, centered brand lockup, giant
// paper RASAMALA mark clipped at the bottom edge.
interface Props {
	locale?: Locale;
	currentPath?: string;
}

const { locale = "id", currentPath = "/" } = Astro.props;
const t = getStrings(locale);
const L = (p: string) => localizePath(p, locale);

const exploreLinks = [
	{ href: L("/about-us/"), label: t.nav.about },
	{ href: L("/location/"), label: t.nav.location },
	{ href: L("/attractions/"), label: t.nav.attractions },
	{ href: L("/gallery/"), label: t.nav.gallery },
	{ href: L("/blog/"), label: t.nav.blog },
	{ href: L("/contact-us/"), label: t.nav.contact },
];
const stayLinks = [
	{ href: L("/villa/"), label: t.nav.allVillas },
	{ href: L("/glamping/"), label: t.nav.allGlamping },
	{ href: L("/campsite/"), label: t.nav.campsite },
	{ href: L("/package/"), label: t.nav.allPackages },
];
const contactLinks = [
	{ href: waGeneral(), label: `WhatsApp: +${SITE.whatsapp}`, external: true },
	{ href: `mailto:${SITE.email}`, label: SITE.email, external: false },
	...SITE.phones.map((p) => ({
		href: `tel:+62${p.replace(/\D/g, "").slice(1)}`,
		label: p,
		external: false,
	})),
];
const socials = [
	{
		href: SITE.socials.instagram,
		label: "Instagram",
		icon: '<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />',
	},
	{
		href: SITE.socials.tiktok,
		label: "TikTok",
		icon: '<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M14 4c.4 2.6 2 4.3 4.5 4.7" />',
	},
	{
		href: SITE.socials.youtube,
		label: "YouTube",
		icon: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" /><path d="m10 15 5-3-5-3z" />',
	},
	{
		href: SITE.socials.facebook,
		label: "Facebook",
		icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />',
	},
];
---

<footer class="site-footer">
	<div class="footer-panel">
		<div class="link-rows">
			<nav aria-label={t.footer.explore}>
				<h3>{t.footer.explore}</h3>
				<ul>
					{exploreLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
				</ul>
			</nav>

			<nav aria-label={t.footer.stay}>
				<h3>{t.footer.stay}</h3>
				<ul>
					{stayLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
				</ul>
			</nav>

			<div class="footer-contact">
				<h3>{t.footer.contact}</h3>
				<ul>
					{contactLinks.map((l) => (
						<li>
							<a
								href={l.href}
								target={l.external ? "_blank" : undefined}
								rel={l.external ? "noopener" : undefined}
							>
								{l.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="footer-socials">
			<ul class="socials">
				{socials.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={s.icon}
							/>
						</a>
					</li>
				))}
			</ul>
			<span class="social-divider" aria-hidden="true"></span>
			<a href={L("/")} class="brand" aria-label="Pondok Rasamala">
				<img
					src="/brand/rasamala-badge.png"
					alt=""
					width="34"
					height="34"
					class="brand-badge"
				/>
				<span class="wordmark">Pondok Rasamala</span>
			</a>
		</div>

		<div class="footer-bottom">
			<p>&copy; {new Date().getFullYear()} Pondok Rasamala. {t.footer.rights}</p>
			<div class="bottom-right">
				<LanguageToggle locale={locale} path={currentPath} variant="inline" class="footer-lang" />
				<a href="#main-content" class="to-top">{t.footer.backToTop} ↑</a>
			</div>
		</div>

		<p class="footer-mark" aria-hidden="true">Rasamala</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-bg);
		padding: 0 var(--spacing-sm) var(--spacing-sm);
	}
	.footer-panel {
		container-type: inline-size;
		position: relative;
		overflow: hidden;
		max-width: var(--wide-width);
		margin: 0 auto;
		border-radius: var(--radius-lg);
		color: #ffffff;
		background:
			radial-gradient(
				120% 60% at 50% 0%,
				color-mix(in srgb, var(--color-brand) 30%, transparent),
				transparent 55%
			),
			radial-gradient(
				100% 55% at 50% 100%,
				color-mix(in srgb, var(--color-brand) 38%, transparent),
				transparent 70%
			),
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-brand-strong) 38%, var(--color-footer)) 0%,
				var(--color-footer) 60%,
				color-mix(in srgb, var(--color-brand-strong) 30%, var(--color-footer)) 100%
			);
		padding: var(--spacing-3xl) var(--spacing-lg) 0;
	}
	/* Centered link rows with room to breathe. */
	.link-rows {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-lg);
		max-width: 820px;
		margin: 0 auto;
		text-align: center;
	}
	.site-footer h3 {
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		margin-bottom: var(--spacing-sm);
		opacity: 1;
		color: #ffffff;
	}
	.site-footer ul {
		list-style: none;
	}
	.link-rows a {
		display: inline-block;
		font-size: var(--font-size-sm);
		padding: 0.3rem 0;
		color: #ffffff;
	}
	.link-rows a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.footer-socials {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: var(--spacing-xl);
		margin-top: var(--spacing-xl);
		padding-top: var(--spacing-xl);
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		max-width: 820px;
		margin-left: auto;
		margin-right: auto;
	}
	.social-divider {
		width: 1px;
		align-self: stretch;
		background: rgba(255, 255, 255, 0.25);
	}
	.footer-socials .brand-badge {
		width: 34px;
		height: 34px;
	}
	.footer-socials .wordmark {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.01em;
	}
	.socials {
		display: flex;
		gap: var(--spacing-md);
	}
	.socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.55);
		border-radius: 50%;
		transition:
			transform var(--transition-fast),
			background-color var(--transition-fast);
	}
	.socials a:hover {
		transform: translateY(-3px);
		background: rgba(247, 245, 241, 0.12);
	}
	.socials svg {
		width: 18px;
		height: 18px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
	}
	.brand-badge {
		border-radius: 50%;
		object-fit: cover;
	}
	.wordmark {
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		white-space: nowrap;
	}
	.footer-bottom {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-md);
		max-width: 820px;
		margin: var(--spacing-xl) auto 0;
		padding: var(--spacing-md) 0;
		font-size: var(--font-size-sm);
		color: #ffffff;
		border-top: 1px solid rgba(255, 255, 255, 0.25);
	}
	.bottom-right {
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
		margin-left: auto;
	}
	.to-top {
		white-space: nowrap;
		font-weight: 600;
		color: inherit;
	}
	.to-top:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* Giant mark: container-query sized, paper on forest, clipped edge. */
	.footer-mark {
		margin: var(--spacing-sm) 0 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 12.5cqw;
		line-height: 0.85;
		letter-spacing: -0.03em;
		text-align: center;
		white-space: nowrap;
		color: #f7f5f1;
		user-select: none;
		pointer-events: none;
		transform: translateY(0.1em);
	}
	@media (max-width: 700px) {
		.link-rows {
			grid-template-columns: 1fr;
			gap: var(--spacing-2xl);
		}
		.footer-bottom {
			flex-direction: column;
			text-align: center;
		}
		.bottom-right {
			margin-left: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.socials a {
			transition: none;
		}
		.socials a:hover {
			transform: none;
		}
	}
</style>
