---
import { getStrings, type Locale } from "../../lib/i18n";

// Light/dark switch with a way back to "follow system". The whole palette is
// light-dark() pairs, so one color-scheme on <html> re-resolves every token.
// The state lives in <meta name="color-scheme"> ("light dark" = follow the OS,
// "light"/"dark" = override), which theme.css maps onto <html> via :has().
// An override is stored in localStorage["pr-theme"]; picking the scheme the OS
// already uses removes it. Icons are pure CSS off the same meta + media query,
// so the right glyph shows even without JS.
// One label describes the ACTION ("switch to dark mode") rather than the state.
interface Props {
	locale?: Locale;
	class?: string;
}

const { locale = "id", class: className = "" } = Astro.props;
const t = getStrings(locale);
---

<button
	type="button"
	class:list={["theme-toggle", className]}
	data-theme-toggle
	aria-label={t.actions.switchToDark}
	data-label-dark={t.actions.switchToDark}
	data-label-light={t.actions.switchToLight}
>
	<svg
		class="icon-moon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.7"
		stroke-linecap="round"
		aria-hidden="true"
		focusable="false"
	>
		<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
	</svg>
	<svg
		class="icon-sun"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.7"
		stroke-linecap="round"
		aria-hidden="true"
		focusable="false"
	>
		<circle cx="12" cy="12" r="4.2"></circle>
		<path d="M12 3v1.8M12 19.2V21M3 12h1.8M19.2 12H21M5.6 5.6l1.3 1.3M17.1 17.1l1.3 1.3M18.4 5.6l-1.3 1.3M6.9 17.1l-1.3 1.3"
		></path>
	</svg>
</button>

<script>
	// Runs once per page even with several toggles (header + drawer).
	const STORAGE_KEY = "pr-theme";
	// Keep in sync with the inline head script in Base.astro.
	const BAR = { light: "#016747", dark: "#161a17" };
	const system = window.matchMedia("(prefers-color-scheme: dark)");
	const schemeMeta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
	const barMetas = Array.from(
		document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]'),
	);
	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"),
	);

	type Scheme = "light" | "dark";

	function readStored(): Scheme | null {
		try {
			const v = localStorage.getItem(STORAGE_KEY);
			return v === "light" || v === "dark" ? v : null;
		} catch {
			return null;
		}
	}

	const systemScheme = (): Scheme => (system.matches ? "dark" : "light");

	// The meta is the page's source of truth, so a choice still holds when
	// storage is unavailable (private mode).
	function override(): Scheme | null {
		const v = schemeMeta?.content;
		return v === "light" || v === "dark" ? v : null;
	}

	const rendered = (): Scheme => override() ?? systemScheme();

	function sync() {
		const dark = rendered() === "dark";
		for (const btn of buttons) {
			btn.setAttribute(
				"aria-label",
				dark ? (btn.dataset.labelLight ?? "") : (btn.dataset.labelDark ?? ""),
			);
			btn.setAttribute("aria-pressed", String(dark));
		}
	}

	// Apply an override (or null = follow system) to the meta tags.
	function apply(value: Scheme | null) {
		if (schemeMeta) schemeMeta.content = value ?? "light dark";
		for (const m of barMetas) {
			// Override: one colour for both metas. Follow system: restore per media.
			m.content = value ? BAR[value] : m.media.includes("dark") ? BAR.dark : BAR.light;
		}
		sync();
	}

	for (const btn of buttons) {
		btn.addEventListener("click", () => {
			// Re-read each time: another tab may have changed the choice.
			const stored = readStored();
			if (stored && stored !== override()) apply(stored);
			const target: Scheme = rendered() === "dark" ? "light" : "dark";
			try {
				if (target === systemScheme()) {
					// Undoing an override: back to following the OS, store nothing.
					localStorage.removeItem(STORAGE_KEY);
				} else {
					localStorage.setItem(STORAGE_KEY, target);
				}
			} catch {
				/* private mode: the choice lasts for this page only */
			}
			apply(target === systemScheme() ? null : target);
		});
	}

	// An OS change only matters while following the OS (CSS already handles
	// the palette); an override is never touched or cleared by it.
	system.addEventListener("change", sync);

	// Keep other tabs in step (storage events fire in the other documents only).
	window.addEventListener("storage", (e) => {
		if (e.key === STORAGE_KEY || e.key === null) apply(readStored());
	});

	// Back/forward cache restores can hold a stale choice.
	window.addEventListener("pageshow", (e) => {
		if (e.persisted) apply(readStored());
	});

	sync();
</script>

<style>
	/* Sized to match the language dropdown pill next to it. */
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: none;
		color: var(--color-muted);
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background-color 0.2s ease;
	}
	.theme-toggle:hover {
		color: var(--color-text);
		border-color: var(--color-muted);
	}
	.theme-toggle svg {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}
	/* The visible glyph is the mode you would switch TO (sun while dark).
	   Rendered scheme = override meta, else the OS preference. */
	.icon-sun {
		display: none;
	}
	:global(:root:has(> head > meta[name="color-scheme"][content="dark"])) .icon-sun {
		display: block;
	}
	:global(:root:has(> head > meta[name="color-scheme"][content="dark"])) .icon-moon {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) .icon-sun {
			display: block;
		}
		:global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) .icon-moon {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.theme-toggle {
			transition: none;
		}
	}
</style>
