---
interface Props {
	label: string;
	ratio?: string;
	class?: string;
}

const { label, ratio = "16 / 10", class: className = "" } = Astro.props;
---

<div
	class={`photo-placeholder ${className}`}
	style={`aspect-ratio: ${ratio};`}
	role="img"
	aria-label={label}
>
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
		<path d="M3 18 9 11l4 4 3-3 5 6H3Z" />
		<circle cx="16.5" cy="8.5" r="2" />
	</svg>
	<span>{label}</span>
</div>

<style>
	.photo-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-sm);
		width: 100%;
		color: var(--color-wood);
		background:
			radial-gradient(120% 100% at 50% 0%, var(--color-brand-soft) 0%, transparent 60%),
			var(--color-surface);
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-lg);
	}
	.photo-placeholder svg {
		width: 40px;
		height: 40px;
		opacity: 0.7;
	}
	.photo-placeholder span {
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.8;
		padding: 0 var(--spacing-md);
		text-align: center;
	}
</style>
