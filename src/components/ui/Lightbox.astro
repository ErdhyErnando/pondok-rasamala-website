---
import Photo from "./Photo.astro";
import type { Locale } from "../../lib/i18n";
import type { Photo as PhotoData } from "../../lib/photos";

// Photo strip + native <dialog> lightbox, vanilla JS only.
// Items with a `photo` render real WebP images; label-only items keep the
// placeholder (the gallery page still uses those). The dialog holds one
// full-size <Photo> per item and only the current one is visible: images in
// a closed dialog are not fetched (loading="lazy"), and each step shows the
// next one from the same source at a larger width than the strip thumbnail.
// Wiring is per-instance via DOM data (no define:vars, no framework).
interface Props {
	items: Array<{ label: string; photo?: PhotoData }>;
	closeLabel: string;
	prevLabel: string;
	nextLabel: string;
	locale?: Locale;
	/** First item shown in the strip. Earlier items are still in the dialog,
	 *  for pages that already show them elsewhere (the detail-page grid). */
	stripFrom?: number;
	/** `sizes` for the strip thumbnails (3 columns, 2 under 600 px). */
	stripSizes?: string;
}

const {
	items,
	closeLabel,
	prevLabel,
	nextLabel,
	locale = "id",
	stripFrom = 0,
	stripSizes = "(min-width: 601px) calc(33vw - 24px), 50vw",
} = Astro.props;
// Per instance: a page may render more than one lightbox.
const uid = `lb-${crypto.randomUUID().slice(0, 8)}`;
// Dialog: min(880px, 92vw) wide, minus 24px padding and 1px border each side.
const fullSizes = "(min-width: 957px) 830px, calc(92vw - 50px)";
---

<div class="photo-strip" data-strip data-items={JSON.stringify(items.map((i) => i.label))}>
	{items.map((item, i) => i >= stripFrom && (
		<button
			type="button"
			class="strip-item"
			data-index={i}
			aria-label={item.photo ? undefined : item.label}
			aria-haspopup="dialog"
		>
			<Photo photo={item.photo} locale={locale} sizes={stripSizes} widths={[480, 960]} ratio="4 / 3" label={item.label} />
		</button>
	))}
</div>

<dialog class="lightbox" closedby="any" aria-labelledby={`${uid}-caption`}>
	<div class="lightbox-inner" data-full>
		{items.map((item, i) => (
			<div data-full-item hidden={i !== 0}>
				<Photo
					photo={item.photo}
					locale={locale}
					sizes={fullSizes}
					widths={[960, 1600, 2400]}
					class="lightbox-photo"
					label={item.label}
					ratio="16 / 10"
				/>
			</div>
		))}
		<p class="lightbox-caption" id={`${uid}-caption`} data-caption>{items[0]?.label ?? ""}</p>
	</div>
	<div class="lightbox-bar">
		<button type="button" data-prev aria-label={prevLabel}>←</button>
		<span data-count aria-live="polite">1 / {items.length}</span>
		<button type="button" data-next aria-label={nextLabel}>→</button>
		<form method="dialog"><button type="submit">{closeLabel}</button></form>
	</div>
</dialog>

<script>
	document.querySelectorAll<HTMLElement>("[data-strip]").forEach((strip) => {
		const labels = JSON.parse(strip.dataset.items ?? "[]") as string[];
		const dialog = strip.nextElementSibling;
		if (!(dialog instanceof HTMLDialogElement)) return;
		const fullItems = dialog.querySelectorAll<HTMLElement>("[data-full-item]");
		const caption = dialog.querySelector("[data-caption]");
		const count = dialog.querySelector("[data-count]");
		let index = 0;

		function render() {
			const label = labels[index];
			if (label === undefined) return;
			fullItems.forEach((el, i) => (el.hidden = i !== index));
			if (caption) caption.textContent = label;
			if (count) count.textContent = `${index + 1} / ${labels.length}`;
		}

		strip.querySelectorAll("[data-index]").forEach((btn) => {
			btn.addEventListener("click", () => {
				index = Number(btn.getAttribute("data-index"));
				render();
				dialog.showModal();
			});
		});
		// Other parts of a page (e.g. the detail-page photo grid) open the dialog
		// at a given item by dispatching `lightbox-open` on the strip.
		strip.addEventListener("lightbox-open", (e) => {
			index = Number((e as CustomEvent<number>).detail) || 0;
			render();
			if (!dialog.open) dialog.showModal();
		});
		dialog.querySelector("[data-prev]")?.addEventListener("click", () => {
			index = (index - 1 + labels.length) % labels.length;
			render();
		});
		dialog.querySelector("[data-next]")?.addEventListener("click", () => {
			index = (index + 1) % labels.length;
			render();
		});
		dialog.addEventListener("keydown", (e) => {
			if (e.key === "ArrowLeft") dialog.querySelector<HTMLElement>("[data-prev]")?.click();
			else if (e.key === "ArrowRight") dialog.querySelector<HTMLElement>("[data-next]")?.click();
		});
		// Light dismiss is declarative (closedby="any") where supported. Safari
		// lacks it, so fall back to a click that lands outside the dialog's box.
		// Comparing coordinates, not just e.target === dialog, matters: a click
		// on the dialog's own padding also targets the dialog but is not outside.
		if (!("closedBy" in HTMLDialogElement.prototype)) {
			dialog.addEventListener("click", (e) => {
				if (e.target !== dialog) return;
				const r = dialog.getBoundingClientRect();
				const inside =
					r.top <= e.clientY && e.clientY <= r.bottom && r.left <= e.clientX && e.clientX <= r.right;
				if (!inside) dialog.close();
			});
		}
	});
</script>

<style>
	.photo-strip {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-md);
	}
	.strip-item {
		background: transparent;
		border: 0;
		padding: 0;
		cursor: zoom-in;
		font: inherit;
	}
	.strip-item :global(.photo-img) {
		border-radius: var(--radius);
	}
	.lightbox {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		color: var(--color-text);
		padding: var(--spacing-lg);
		max-width: min(880px, 92vw);
		width: 100%;
		/* The global `* { margin: 0 }` reset beats the UA `margin: auto` that
		   centres a modal dialog, so restore it here. */
		margin: auto;
	}
	/* Keep wheel/touch scrolling from chaining to the page. No overflow lock on
	   <html>/<body>: that shifts layout and does not stop iOS overscroll. */
	.lightbox:modal {
		overscroll-behavior: contain;
	}
	.lightbox::backdrop {
		overflow: hidden;
		overscroll-behavior: contain;
		background: rgb(0 0 0 / 0.6);
	}
	.lightbox-bar form {
		display: contents;
	}
	/* Real photos keep their own ratio but never outgrow the viewport
	   (portrait shots are about 1:2). Placeholders keep their 16 / 10 box. */
	.lightbox :global(img.lightbox-photo) {
		width: auto;
		max-width: 100%;
		max-height: min(70vh, 70svh);
		margin-inline: auto;
		object-fit: contain;
		background: transparent;
		border-radius: var(--radius);
	}
	.lightbox-caption {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-align: center;
	}
	.lightbox-bar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-md);
	}
	.lightbox-bar button {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-text);
		border-radius: var(--radius-sm);
		min-width: 44px;
		min-height: 44px;
		padding: 0 var(--spacing-md);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	@media (max-width: 600px) {
		.photo-strip {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
