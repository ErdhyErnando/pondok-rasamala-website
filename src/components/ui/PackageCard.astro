---
import Photo from "./Photo.astro";
import type { Locale } from "../../lib/i18n";
import type { Photo as PhotoData } from "../../lib/photos";

// Package card (artifact layout): photo beside the text, solid rule on top.
// Name, tagline, up to three activity chips, then "From Rp… per person".
// Whole card is clickable via the stretched name link.
interface Props {
	href: string;
	name: string;
	tagline: string;
	activities?: string[];
	priceSummary: string;
	priceUnit?: string;
	imageLabel: string;
	/** Real photo; without one the card shows the labelled placeholder. */
	photo?: PhotoData;
	locale?: Locale;
	/** Photo width per breakpoint. The default matches the 2-column index:
	 *  1200 px container, 24 px padding, 32 px gap, text and photo split 6 : 5
	 *  with a 24 px gap, and a single column under 901 px (photo on top under 481 px). */
	sizes?: string;
}

const {
	href,
	name,
	tagline,
	activities = [],
	priceSummary,
	priceUnit,
	imageLabel,
	photo,
	locale = "id",
	sizes = "(min-width: 1200px) 243px, (min-width: 901px) calc(((100vw - 80px) / 2 - 24px) * 5 / 11), (min-width: 481px) calc((100vw - 72px) * 5 / 11), calc(100vw - 48px)",
} = Astro.props;
---

<article class="pk reveal">
	<a href={href} class="pk-visual" aria-hidden="true" tabindex="-1">
		<Photo photo={photo} locale={locale} sizes={sizes} widths={[480, 960]} ratio={photo ? "4 / 3" : "4 / 5"} label={imageLabel} />
	</a>
	<div class="pk-body">
		<h3><a href={href}>{name}</a></h3>
		<p class="pk-tag">{tagline}</p>
		{activities.length > 0 && (
			<ul class="pk-chips">
				{activities.map((a) => <li>{a}</li>)}
			</ul>
		)}
		<p class="pk-price">
			{priceSummary}
			{priceUnit && <small>{priceUnit}</small>}
		</p>
	</div>
</article>

<style>
	.pk {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: var(--spacing-lg);
		align-items: start;
		padding-top: var(--spacing-lg);
		border-top: 1px solid var(--color-text);
	}
	.pk-visual {
		display: block;
	}
	.pk-visual :global(.photo-placeholder),
	.pk-visual :global(.photo-img) {
		border-radius: var(--radius);
		transition: transform var(--transition-base);
	}
	.pk:hover .pk-visual :global(.photo-placeholder),
	.pk:hover .pk-visual :global(.photo-img) {
		transform: translateY(-2px);
	}
	.pk-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		min-width: 0;
	}
	.pk-body h3 {
		font-size: var(--font-size-2xl);
		line-height: 1.15;
	}
	.pk-body h3 a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.pk:hover h3 {
		color: var(--color-brand);
	}
	.pk-tag {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}
	.pk-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		padding: 0;
		margin: var(--spacing-xs) 0 0;
	}
	.pk-chips li {
		padding: 4px 10px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
	.pk-price {
		margin-top: var(--spacing-sm);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.pk-price small {
		margin-left: 4px;
		font-weight: 400;
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
	@media (max-width: 480px) {
		.pk {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pk-visual :global(.photo-placeholder),
		.pk-visual :global(.photo-img) {
			transition: none;
		}
	}
</style>
