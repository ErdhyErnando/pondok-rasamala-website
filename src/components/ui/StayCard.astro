---
import Photo from "./Photo.astro";
import type { Locale } from "../../lib/i18n";
import type { Photo as PhotoData } from "../../lib/photos";
import type { StayFact } from "../../lib/stay";

// One card anatomy for every stay (villa, glamping, campsite lot):
// photo, serif name, blurb, then either a facts strip (rooms · capacity ·
// price) or a plain link line when there are no per-unit facts (campsite lots).
// Whole card is clickable via the stretched name link.
interface Props {
	href: string;
	name: string;
	blurb: string;
	imageLabel: string;
	/** Real photo; without one the card shows the labelled placeholder. */
	photo?: PhotoData;
	locale?: Locale;
	/** Card width per breakpoint. The default matches the shared 3 / 2 / 1
	 *  column stay grid (StayIndex and the "other stays" row): 1200 px
	 *  container, 24 px padding, 32 px gaps, breakpoints at 960 and 600. */
	sizes?: string;
	facts?: StayFact[];
	cta?: string;
	external?: boolean;
	/** Index filter/sort hooks (optional). */
	paxMin?: number;
	paxMax?: number;
	minPrice?: number;
}

const {
	href,
	name,
	blurb,
	imageLabel,
	photo,
	locale = "id",
	sizes = "(min-width: 1200px) 363px, (min-width: 961px) calc((100vw - 112px) / 3), (min-width: 601px) calc((100vw - 80px) / 2), calc(100vw - 48px)",
	facts,
	cta,
	external = false,
	paxMin,
	paxMax,
	minPrice,
} = Astro.props;
---

<article
	class="stay-card reveal"
	data-card
	data-pax-min={paxMin}
	data-pax-max={paxMax}
	data-price={minPrice}
>
	<span class="card-visual" aria-hidden={photo ? undefined : "true"}>
		<Photo photo={photo} locale={locale} sizes={sizes} widths={[480, 960]} ratio="4 / 3" label={imageLabel} />
	</span>
	<h3 class="card-name">
		<a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>{name}</a>
	</h3>
	<p class="card-blurb">{blurb}</p>
	{facts && facts.length > 0 ? (
		<div class="facts">
			{facts.map((f) => (
				<span><b>{f.value}</b>{f.label}</span>
			))}
		</div>
	) : cta ? (
		<p class="card-cta">{cta} →</p>
	) : null}
</article>

<style>
	.stay-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.stay-card[hidden] {
		display: none;
	}
	.card-visual :global(.photo-placeholder),
	.card-visual :global(.photo-img) {
		border-radius: var(--radius);
		margin-bottom: var(--spacing-sm);
		transition: transform var(--transition-base);
	}
	.stay-card:hover .card-visual :global(.photo-placeholder),
	.stay-card:hover .card-visual :global(.photo-img) {
		transform: translateY(-2px);
	}
	.card-name {
		font-size: var(--font-size-xl);
		line-height: 1.15;
	}
	.card-name a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.stay-card:hover .card-name {
		color: var(--color-brand);
	}
	.card-blurb {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		flex-grow: 1;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs) var(--spacing-lg);
		margin-top: var(--spacing-md);
		padding-top: var(--spacing-sm);
		border-top: 1px solid var(--color-border);
		font-size: 0.8125rem;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}
	.facts b {
		display: block;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 1.0625rem;
		color: var(--color-text);
	}
	.card-cta {
		margin-top: var(--spacing-md);
		padding-top: var(--spacing-sm);
		border-top: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
	}
	@media (prefers-reduced-motion: reduce) {
		.card-visual :global(.photo-placeholder),
		.card-visual :global(.photo-img) {
			transition: none;
		}
	}
</style>
