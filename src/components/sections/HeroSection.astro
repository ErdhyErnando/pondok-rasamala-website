---
import WhatsAppButton from "../ui/WhatsAppButton.astro";
import { hero, tx } from "../../data/home";
import type { Locale } from "../../lib/i18n";

// Full-bleed overlay hero (Paper DS v1, Well Traveled ref):
// centered serif H1 + short sub + one forest CTA over a scenic panel.
// The panel is CSS art until Day 6 photography lands, swap .hero-bg
// for <Image image={{ src, alt }} /> (object, not string) from
// "emdash/ui" and keep the scrim so white text stays contrast-safe.
interface Props {
	locale?: Locale;
}

const { locale = "id" } = Astro.props;
const message =
	locale === "en"
		? "Hello Pondok Rasamala, I'd like to ask about staying over. Thank you."
		: "Halo Pondok Rasamala, saya mau bertanya tentang menginap. Terima kasih.";
---

<section class="hero-overlay">
	<div class="hero-panel">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="hero-scrim" aria-hidden="true"></div>
		<div class="hero-inner">
			<h1 class="reveal">{tx(hero.title, locale)}</h1>
			<p class="hero-sub reveal">{tx(hero.sub, locale)}</p>
			<div class="hero-actions reveal">
				<WhatsAppButton message={message} locale={locale} size="lg" />
			</div>
		</div>
	</div>
</section>

<style>
	.hero-overlay {
		padding: var(--spacing-sm) var(--spacing-sm) 0;
	}
	.hero-panel {
		position: relative;
		overflow: hidden;
		display: flex;
		min-height: 100svh;
		border-radius: var(--radius-lg);
		background: #0c211a;
		isolation: isolate;
	}
	/* Salak-ridge CSS art: amber glow through leaves, back + front ridges.
	   Day 6: replace with a real <Image> and delete ::before/::after. */
	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		background:
			radial-gradient(90% 55% at 72% 16%, rgba(232, 147, 12, 0.32), transparent 60%),
			radial-gradient(70% 50% at 18% 88%, rgba(1, 103, 71, 0.6), transparent 65%),
			linear-gradient(180deg, #16402f 0%, #0e2c22 45%, #0a1d16 100%);
	}
	.hero-bg::before,
	.hero-bg::after {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 52%;
	}
	.hero-bg::before {
		background: linear-gradient(180deg, #1d4a37, #143728);
		clip-path: polygon(0 62%, 12% 38%, 26% 55%, 40% 22%, 55% 48%, 70% 30%, 84% 52%, 100% 36%, 100% 100%, 0 100%);
		opacity: 0.9;
	}
	.hero-bg::after {
		background: linear-gradient(180deg, #0d281e, #07170f);
		clip-path: polygon(0 78%, 15% 58%, 30% 74%, 46% 50%, 62% 72%, 78% 56%, 100% 74%, 100% 100%, 0 100%);
	}
	.hero-scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(7, 14, 11, 0.62) 0%,
			rgba(7, 14, 11, 0.28) 42%,
			rgba(7, 14, 11, 0.68) 100%
		);
	}
	.hero-inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 1080px;
		margin: auto;
		padding: clamp(4.5rem, 10vw, 7rem) var(--spacing-lg) clamp(3.5rem, 7vw, 5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.hero-inner h1 {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 6vw, 4.25rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
		font-weight: var(--font-weight-display);
		color: #fff;
		text-wrap: balance;
	}
	.hero-sub {
		font-size: var(--font-size-lg);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.86);
		max-width: 60ch;
		margin-top: var(--spacing-lg);
		text-wrap: balance;
	}
	.hero-actions {
		display: flex;
		justify-content: center;
		margin-top: var(--spacing-xl);
	}
	@media (max-width: 900px) {
		.hero-overlay {
			padding: var(--spacing-xs) var(--spacing-xs) 0;
		}
		.hero-panel {
			border-radius: var(--radius);
			min-height: 0;
		}
		.hero-inner {
			padding: 4rem var(--spacing-md) 3rem;
		}
		.hero-inner h1 {
			font-size: clamp(1.875rem, 9vw, 2.5rem);
		}
		.hero-sub {
			font-size: var(--font-size-base);
			margin-top: var(--spacing-md);
		}
	}
</style>
