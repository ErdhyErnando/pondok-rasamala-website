---
import { testimonials, testimonialsHead, tx } from "../../data/home";
import type { Locale } from "../../lib/i18n";

// Single large quote (Well Traveled lock): one REAL public review,
// linked to source. The featured quote rotates by editing data/home.ts.
interface Props {
	locale?: Locale;
}

const { locale = "id" } = Astro.props;
const featured = testimonials[0];
---

<section class="testimonials">
	<div class="container testimonials-inner">
		<p class="eyebrow reveal">{tx(testimonialsHead.eyebrow, locale)}</p>
		<figure class="quote reveal">
			<div class="stars" aria-hidden="true">{"★".repeat(5)}</div>
			<blockquote>“{tx(featured.quote, locale)}”</blockquote>
			<figcaption>
				<span class="author">{featured.name}</span>
				<span class="context">{tx(featured.context, locale)} · </span>
				<a
					href={featured.source}
					target="_blank"
					rel="noopener"
					class="source">{featured.sourceLabel} ↗</a
				>
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.testimonials {
		padding: var(--section-pad) 0;
		border-top: 1px solid var(--color-border);
	}
	.testimonials-inner {
		text-align: center;
		max-width: 880px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: var(--spacing-lg);
	}
	.stars {
		color: var(--color-accent);
		letter-spacing: 0.2em;
		margin-bottom: var(--spacing-lg);
	}
	.quote blockquote {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1.3;
		letter-spacing: -0.02em;
		font-weight: var(--font-weight-display);
		text-wrap: balance;
	}
	.quote figcaption {
		margin-top: var(--spacing-lg);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.author {
		font-weight: 700;
		color: var(--color-text);
	}
	.source {
		color: var(--color-brand);
		font-weight: 600;
	}
</style>
