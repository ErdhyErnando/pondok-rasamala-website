---
import SectionHeader from "../ui/SectionHeader.astro";
import { testimonials, testimonialsHead, tx } from "../../data/home";
import type { Locale } from "../../lib/i18n";

// Static quote cards from REAL public reviews — linked to source.
// Any invented quote is rejected: see docs/day-2-copy.md for provenance.
interface Props {
	locale?: Locale;
}

const { locale = "id" } = Astro.props;
---

<section class="testimonials">
	<div class="container">
		<SectionHeader
			eyebrow={tx(testimonialsHead.eyebrow, locale)}
			title={tx(testimonialsHead.title, locale)}
		/>
		<div class="quote-grid">
			{testimonials.map((item) => (
				<figure class="quote-card reveal">
					<div class="stars" aria-hidden="true">{"★".repeat(5)}</div>
					<blockquote>“{tx(item.quote, locale)}”</blockquote>
					<figcaption>
						<span class="author">{item.name}</span>
						<span class="context">{tx(item.context, locale)}</span>
						<a
							href={item.source}
							target="_blank"
							rel="noopener"
							class="source">{item.sourceLabel} ↗</a
						>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<style>
	.testimonials {
		padding: var(--section-pad) 0;
	}
	.quote-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-xl);
	}
	.quote-card {
		display: flex;
		flex-direction: column;
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.stars {
		color: var(--color-accent);
		letter-spacing: 0.2em;
		margin-bottom: var(--spacing-md);
	}
	.quote-card blockquote {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		line-height: 1.5;
		flex-grow: 1;
		text-wrap: pretty;
	}
	.quote-card figcaption {
		margin-top: var(--spacing-lg);
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		font-size: var(--font-size-sm);
	}
	.author {
		font-weight: 700;
	}
	.context {
		color: var(--color-muted);
	}
	.source {
		color: var(--color-brand);
		font-weight: 600;
	}
	@media (max-width: 900px) {
		.quote-grid {
			grid-template-columns: 1fr;
			max-width: 560px;
			margin: 0 auto;
		}
	}
</style>
