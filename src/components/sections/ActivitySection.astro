---
import PhotoPlaceholder from "../ui/PhotoPlaceholder.astro";
import { activities, tx } from "../../data/home";
import { localizePath, type Locale } from "../../lib/i18n";

// Three category columns (big serif word, photo, title, blurb, link) split by
// dashed vertical rules, under a heavy top rule. Layout lifted from the
// "field notebook" artifact; colours/tokens stay the site's own.
interface Props {
	locale?: Locale;
}

const { locale = "id" } = Astro.props;
const L = (p: string) => localizePath(p, locale);
---

<section class="activities">
	<div class="container">
		<div class="act-head">
			<div class="act-head-main reveal">
				<p class="eyebrow">{tx(activities.eyebrow, locale)}</p>
				<h2>{tx(activities.title, locale)}</h2>
			</div>
		</div>

		<ul class="acts">
			{activities.cards.map((c) => (
				<li class="act reveal">
					<span class="act-word">{tx(c.word, locale)}</span>
					<PhotoPlaceholder label={tx(c.imageLabel, locale)} ratio="3 / 2" class="act-photo" />
					<h3>{tx(c.title, locale)}</h3>
					<p>{tx(c.body, locale)}</p>
					<a href={L(c.href)} class="act-more">{tx(c.linkLabel, locale)}</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.activities {
		padding: var(--section-pad) 0;
	}
	.act-head {
		margin-bottom: var(--spacing-2xl);
	}
	.eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-brand);
		margin-bottom: var(--spacing-sm);
	}
	.act-head h2 {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		text-wrap: balance;
	}

	.acts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--color-text);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.act {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		padding: var(--spacing-xl) var(--spacing-lg) 0;
	}
	.act:first-child {
		padding-left: 0;
	}
	.act:last-child {
		padding-right: 0;
	}
	.act + .act {
		border-left: 1px dashed var(--color-border);
	}
	.act-word {
		font-family: var(--font-heading);
		font-size: clamp(2.2rem, 1.6rem + 2vw, 3.4rem);
		line-height: 0.95;
		letter-spacing: -0.03em;
		font-weight: 500;
		color: var(--color-text);
	}
	.act :global(.act-photo) {
		margin-block: var(--spacing-sm);
		border-radius: var(--radius);
	}
	.act h3 {
		font-size: var(--font-size-lg);
	}
	.act p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}
	.act-more {
		align-self: flex-start;
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 5px;
		transition: text-decoration-color 0.2s ease;
	}
	.act-more:hover {
		text-decoration-color: currentColor;
	}

	/* Phones/tablets: one column of roomy cards so nothing is squished. */
	@media (max-width: 900px) {
		.acts {
			grid-template-columns: 1fr;
			gap: var(--spacing-lg);
			border-top: 0;
		}
		.act,
		.act:first-child,
		.act:last-child {
			padding: var(--spacing-lg);
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-lg);
		}
		.act + .act {
			border-left: 1px solid var(--color-border);
		}
	}
</style>
